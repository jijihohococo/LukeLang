print("=== LukeLang Zoo Simulation ===")
raw "CONTRACT Eater DO"
raw "MUST METHOD eat WITH food"
raw "END CONTRACT"
raw "CONTRACT Sleeper DO"
raw "MUST METHOD sleep WITH hours"
raw "END CONTRACT"
struct Animal IMPLEMENTS Eater, Sleeper {
  raw "HAS name"
  init(name) {
    self.name = name
  }
  fn eat(food) {
    print(self.name + " eats " + food)
  }
  fn sleep(hours) {
    print(self.name + " sleeps for " + hours + " hours")
  }
}
struct Lion : Animal {
  fn roar() {
    print(self.name + " roars loudly!")
  }
  fn eat(food) {
    super.eat(food)
    print(self.name + " tears into the meat fiercely.")
  }
}
struct Elephant : Animal {
  fn eat(food) {
    print(self.name + " gently munches on " + food)
  }
  fn trumpet() {
    print(self.name + " trumpets proudly!")
  }
}
raw "SET simba TO NEW Lion WITH \"Simba\""
raw "SET dumbo TO NEW Elephant WITH \"Dumbo\""
simba.roar()
simba.eat("antelope")
simba.sleep(5)
dumbo.trumpet()
dumbo.eat("bananas")
dumbo.sleep(8)
print("=== End of Zoo Simulation ===")

print("ast roundtrip")
fn double(n: float) -> float {
  return n + n
}
let x: float = 3
let y: float = double(x)
if y > 5 {
  print("big")
} else {
  print("small")
}
var i: float = 0
var sum: float = 0
while i < 3 {
  sum = sum + i
  i = i + 1
}
assert y == 6
assert sum == 3
print("ast_roundtrip_ok=1")

import std/sqlite
import std/auth
print("auth_scoped start")
let db = dbOpen("/tmp/luke_auth_scoped.db")
dbExec(db, "DROP TABLE IF EXISTS notes")
dbExec(db, "CREATE TABLE notes(id INTEGER PRIMARY KEY, user_id TEXT NOT NULL, body TEXT NOT NULL)")
authInit(db)
let uidA = authCreateAccount(db, "a@example.com", "password aaa long")
var ba: list = []
ba.push(uidA)
ba.push("note-a")
dbExecBind(db, "INSERT INTO notes(user_id, body) VALUES(?, ?)", ba)
watch note from db as "SELECT body FROM notes WHERE user_id = ?" for current_user
dbClose(db)
print("auth_scoped_ok=1")
print("uidA=" + uidA)

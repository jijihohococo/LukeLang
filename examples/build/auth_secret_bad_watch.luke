// NEGATIVE: SECRET cell WATCH without FOR CURRENT USER → compile error.
// Expect: unauthorized / requires WATCH … FOR CURRENT USER

IMPORT std/sqlite
IMPORT std/auth

MY NAME IS db SET TO ASK dbOpen WITH "/tmp/luke_auth_secret_bad.db"
ASK dbExec WITH db, "CREATE TABLE IF NOT EXISTS profiles(user_id TEXT, ssn TEXT)"

SECRET REMEMBER ssn AS TEXT
WATCH ssn FROM db AS "SELECT ssn FROM profiles WHERE user_id = 'x'"

SPEAK "should_not_build"

import std/sqlite
import std/auth
print("auth_secret_ok start")
let db = dbOpen("/tmp/luke_auth_secret_ok.db")
dbExec(db, "DROP TABLE IF EXISTS profiles")
dbExec(db, "DROP TABLE IF EXISTS luke_auth_attempts")
dbExec(db, "DROP TABLE IF EXISTS luke_sessions")
dbExec(db, "DROP TABLE IF EXISTS luke_users")
dbExec(db, "CREATE TABLE profiles(user_id TEXT PRIMARY KEY, ssn TEXT NOT NULL)")
authInit(db)
let uid = authCreateAccount(db, "secret@example.com", "password long enough")
var ba: list = []
ba.push(uid)
ba.push("078-05-1120")
dbExecBind(db, "INSERT INTO profiles(user_id, ssn) VALUES(?, ?)", ba)
secret signal ssn: str
assert authAssume(uid) == true
watch ssn from db as "SELECT ssn FROM profiles WHERE user_id = ?" for current_user
bind("lab", ssn)
print("ssn_cell=" + ssn)
raw "WHO SAW ssn"
print("trail=" + authWhoSaw("ssn"))
let left = authAttemptsLeft(db, "secret@example.com")
print("attempts_left=" + left)
raw "REVOKE ACCESS"
print("after_revoke_user=" + current_user)
print("after_revoke_ssn=" + ssn)
dbClose(db)
print("auth_secret_ok=1")

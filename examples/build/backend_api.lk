import std/server
import std/sqlite
import std/json
let setup = dbOpen("/tmp/luke_backend_api.db")
dbExec(setup, "DROP TABLE IF EXISTS users")
dbExec(setup, "DROP TABLE IF EXISTS sessions")
dbExec(setup, "CREATE TABLE users(id INTEGER PRIMARY KEY, name TEXT)")
dbExec(setup, "CREATE TABLE sessions(sid TEXT PRIMARY KEY, user_id TEXT)")
var seed: list = []
seed.push("1")
seed.push("Ada")
dbExecBind(setup, "INSERT INTO users(id, name) VALUES(?, ?)", seed)
dbClose(setup)
fn handle(req: Request) {
  let db = dbOpen("/tmp/luke_backend_api.db")
  let method = httpMethod(req)
  let path = httpPath(req)
  var params: map = {}
  var answered: bool = false
  if method == "GET" {
    if httpMatch(path, "/user/:id", params) {
      let id = params["id"]
      let qmap = httpQueryMap(req)
      let tag = qmap["tag"]
      var binds: list = []
      binds.push(id)
      let name = dbQueryBind(db, "SELECT name FROM users WHERE id = ?", binds)
      httpReply(req, 200, "text/plain", name + "|" + tag)
      answered = true
      print("served=user")
    }
  }
  if !answered {
    if method == "GET" {
      if httpMatch(path, "/me", params) {
        let meSid = httpCookie(req, "luke_sid")
        var meBinds: list = []
        meBinds.push(meSid)
        let uid = dbQueryBind(db, "SELECT user_id FROM sessions WHERE sid = ?", meBinds)
        httpReply(req, 200, "text/plain", "me=" + uid)
        answered = true
        print("served=me")
      }
    }
  }
  if !answered {
    if method == "POST" {
      if httpMatch(path, "/login", params) {
        let body = httpJson(req)
        let userNode = jsonGet(body, "user")
        let user = jsonAsText(userNode)
        let loginSid = "s-" + user
        var loginBinds: list = []
        loginBinds.push(loginSid)
        loginBinds.push("1")
        dbExecBind(db, "INSERT OR REPLACE INTO sessions(sid, user_id) VALUES(?, ?)", loginBinds)
        httpSetCookie(req, "luke_sid", loginSid)
        httpReply(req, 200, "text/plain", "ok")
        answered = true
        print("served=login")
      }
    }
  }
  if !answered {
    if method == "GET" {
      if httpMatch(path, "/ok", params) {
        httpReply(req, 200, "text/plain", "ok")
        answered = true
        print("served=ok")
      }
    }
  }
  if !answered {
    httpReply(req, 404, "text/plain", "not found")
  }
  dbClose(db)
}
print("backend_api :8799")
let server = httpListen(8799)
httpServe(server, handle, 4)
print("backend_api_done=1")

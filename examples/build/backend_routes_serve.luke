// ROUTES table → executable dispatch (SERVE ROUTES codegen).
// Build: luke BUILD examples/build/backend_routes_serve.luke -o build/backend_routes_serve

IMPORT std/server

THIS IS FUNCTION health WITH req AS REQUEST DO
  ASK httpReply WITH req, 200, "text/plain", "ok"
  SPEAK "served=ok"
END FUNCTION

THIS IS FUNCTION show_user WITH req AS REQUEST DO
  MY NAME IS path SET TO ASK httpPath WITH req
  MY NAME IS params AS MAP
  ASK httpMatch WITH path, "/user/:id", params
  MY NAME IS id SET TO GET "id" FROM params
  ASK httpReply WITH req, 200, "text/plain", "user=" AND id
  SPEAK "served=user"
END FUNCTION

ROUTES DO
  GET "/ok" HANDLE health
  GET "/user/:id" AS INTEGER HANDLE show_user
END ROUTES

LINK TO "/ok"
LINK TO "/user/7"

SPEAK "routes_serve :8803"
MY NAME IS server SET TO ASK httpListen WITH 8803
SERVE ROUTES ON server WITH 4
SPEAK "routes_serve_done=1"

// LukeLang browser app — DOM owned by Luke (blank host shell)
// Build: luke BUILD examples/build/browser_app.luke -target browser -o build/app

IMPORT std/js

NAME THE PAGE "LukeLang"

BRING FONT "Syne" FROM "https://fonts.googleapis.com/css2?family=Syne:wght@700&display=swap"

WEAR STYLE """
body { margin:0; font-family: Syne, sans-serif; background:#0f1714; color:#e8f0eb; }
main { max-width:36rem; margin:0 auto; padding:12vh 1.25rem; }
.brand { font-size:clamp(2.5rem,8vw,4rem); font-weight:700; letter-spacing:-0.03em; color:#3ecf8e; margin:0 0 0.5rem; }
button { font:inherit; padding:0.7rem 1rem; cursor:pointer; border:0; background:#3ecf8e; color:#0f1714; }
#out { margin-top:1rem; min-height:1.4em; }
"""

FILL "root" WITH """
<main>
  <p class="brand" id="title">LukeLang</p>
  <p id="tagline"><em>Not JavaScript. Not Python. Not Rust. LukeLang.</em></p>
  <button type="button" id="go">Try me</button>
  <p id="out"></p>
</main>
"""

ASK jsOnClick WITH "go", "out", "You clicked — still LukeLang underneath."

import std/server
fn handle(req: Request) {
  let path = httpPath(req)
  if path == "/slow" {
    let t0: float = clock
    while clock - t0 < 100 {
    }
    httpReply(req, 200, "text/plain", "slow")
  }
  if path == "/fast" {
    httpReply(req, 200, "text/plain", "fast")
  }
  if path == "/ok" {
    httpReply(req, 200, "text/plain", "ok")
  }
}
print("pressure=concurrent")
print("concurrent pressure :8799")
let server = httpListen(8799)
httpServe(server, handle, 64)
print("server done")

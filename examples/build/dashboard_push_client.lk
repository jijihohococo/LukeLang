import std/js
import std/hanka
import std/argus
page.title("LukeLang Live")
page.style("""
html, body { margin: 0; background: #0c1210; color: #eef7f1; font-family: Georgia, "Times New Roman", serif; }
#root { background:
  radial-gradient(ellipse 80% 50% at 10% 0%, #1a3328 0%, transparent 55%),
  linear-gradient(165deg, #0c1210 0%, #152018 45%, #0c1210 100%); }
#brand { font-size: clamp(32px, 6vw, 48px); font-weight: 700; letter-spacing: -0.03em; color: #f4fff8; }
#tag { font-size: 16px; opacity: 0.72; }
#cpu, #mem, #reqs { font-size: clamp(22px, 4vw, 30px); letter-spacing: 0.02em; }
#paint { font-size: 15px; opacity: 0.75; }
""")
signal reqs = "—"
signal cpu = "37"
signal mem = "54"
signal ready = 0
signal region_now = 0
signal events = 0
raw "BEGIN COLUMN AT 48, 40 SIZE 720, 280 PAD 0 GAP 18"
raw "SLOT TEXT \"brand\" SIZE AUTO, 52 SAY \"LukeLang\""
raw "SLOT TEXT \"tag\" SIZE AUTO, 28 SAY \"Server push → one cell → one region paint.\""
raw "BEGIN ROW AT 0, 0 SIZE AUTO, 56 PAD 0 GAP 28"
raw "SLOT TEXT \"cpu\" SIZE AUTO, 48 SAY \"CPU 37\""
raw "SLOT TEXT \"mem\" SIZE AUTO, 48 SAY \"MEM 54\""
raw "SLOT TEXT \"reqs\" SIZE AUTO, 48 SAY \"REQ —\""
raw "END ROW"
raw "SLOT TEXT \"paint\" SIZE AUTO, 28 SAY \"region paints: —\""
raw "END COLUMN"
raw "LAY OUT THE SCREEN"
raw "PAINT THE SCREEN"
bind("cpu", "CPU " + cpu)
bind("mem", "MEM " + mem)
bind("reqs", "REQ " + reqs)
raw "START SUBSCRIBE \"live\" GET \"http://127.0.0.1:8794/events\" INTO reqs READY ready"
raw """WHEN SUBSCRIBE "live" IS READY DO
  CHANGE region_now TO THE REGION PAINT COUNT
  CHANGE events TO events ADD 1
  UPDATE "paint" WITH "region paints: " AND region_now
  SPEAK "reqs=" AND reqs
  SPEAK "region=" AND region_now
  SPEAK "events=" AND events
END WHEN"""

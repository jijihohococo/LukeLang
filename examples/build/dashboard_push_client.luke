// Flagship — live dashboard on SSE push + Path A fluid flex (no poll glue)
// Build: luke BUILD examples/build/dashboard_push_client.luke -target browser -o build/dashboard_push_client
// Needs: dashboard_push_server on :8794

IMPORT std/js
IMPORT std/hanka
IMPORT std/argus

NAME THE PAGE "LukeLang Live"

WEAR STYLE """
html, body { margin: 0; background: #0c1210; color: #eef7f1; font-family: Georgia, "Times New Roman", serif; }
#root { background:
  radial-gradient(ellipse 80% 50% at 10% 0%, #1a3328 0%, transparent 55%),
  linear-gradient(165deg, #0c1210 0%, #152018 45%, #0c1210 100%); }
#brand { font-size: clamp(32px, 6vw, 48px); font-weight: 700; letter-spacing: -0.03em; color: #f4fff8; }
#tag { font-size: 16px; opacity: 0.72; }
#cpu, #mem, #reqs { font-size: clamp(22px, 4vw, 30px); letter-spacing: 0.02em; }
#paint { font-size: 15px; opacity: 0.75; }
"""

REMEMBER reqs AS "—"
REMEMBER cpu AS "37"
REMEMBER mem AS "54"
REMEMBER ready AS 0
REMEMBER region_now AS 0
REMEMBER events AS 0

BEGIN COLUMN AT 48, 40 SIZE 720, 280 PAD 0 GAP 18
  SLOT TEXT "brand" SIZE AUTO, 52 SAY "LukeLang"
  SLOT TEXT "tag" SIZE AUTO, 28 SAY "Server push → one cell → one region paint."
  BEGIN ROW AT 0, 0 SIZE AUTO, 56 PAD 0 GAP 28
    SLOT TEXT "cpu" SIZE AUTO, 48 SAY "CPU 37"
    SLOT TEXT "mem" SIZE AUTO, 48 SAY "MEM 54"
    SLOT TEXT "reqs" SIZE AUTO, 48 SAY "REQ —"
  END ROW
  SLOT TEXT "paint" SIZE AUTO, 28 SAY "region paints: —"
END COLUMN

LAY OUT THE SCREEN
PAINT THE SCREEN

BIND "cpu" TO "CPU " AND cpu
BIND "mem" TO "MEM " AND mem
BIND "reqs" TO "REQ " AND reqs

START SUBSCRIBE "live" GET "http://127.0.0.1:8794/events" INTO reqs READY ready

WHEN SUBSCRIBE "live" IS READY DO
  CHANGE region_now TO THE REGION PAINT COUNT
  CHANGE events TO events ADD 1
  UPDATE "paint" WITH "region paints: " AND region_now
  SPEAK "reqs=" AND reqs
  SPEAK "region=" AND region_now
  SPEAK "events=" AND events
END WHEN

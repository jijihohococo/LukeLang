import std/hanka
import std/argus
let n: float = 2500
var i: float = 0
var col: float = 0
var row: float = 0
let t0: float = clock
while i < n {
  raw "PLACE \"c\" AND i AS BOX AT col MULTIPLY 8, row MULTIPLY 8 SIZE 6, 6"
  i = i + 1
  col = col + 1
  while col > 49 {
    col = 0
    row = row + 1
  }
}
raw "PAINT THE SCREEN"
let t1: float = clock
let elapsed: float = t1 - t0
print("pressure=frontend")

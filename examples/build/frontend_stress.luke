// Frontend stress + layout benchmark beachhead
// Build: luke BUILD examples/build/frontend_stress.luke -o build/ex_frontend_stress

IMPORT std/hanka
IMPORT std/argus

MY NAME IS i AS NUMBER SET TO 0
MY NAME IS col AS NUMBER SET TO 0
MY NAME IS row AS NUMBER SET TO 0
MY NAME IS t0 AS NUMBER SET TO THE CLOCK

WHILE i IS LESS THAN 100 DO
  PLACE "c" AND i AS BOX AT col MULTIPLY 36, row MULTIPLY 36 SIZE 28, 28
  SET i TO i ADD 1
  SET col TO col ADD 1
  WHILE col IS GREATER THAN 9 DO
    SET col TO 0
    SET row TO row ADD 1
  END WHILE
END WHILE

PAINT THE SCREEN

MY NAME IS t1 AS NUMBER SET TO THE CLOCK
MY NAME IS elapsed AS NUMBER SET TO t1 SUBTRACT t0
SPEAK "nodes=100"
SPEAK "ms=" AND elapsed
SPEAK "ok=1"

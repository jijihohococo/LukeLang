import std/js
import std/hanka
import std/argus
page.title("Hanka")
page.font("Syne", "https://fonts.googleapis.com/css2?family=Syne:wght@700&display=swap")
page.style("""
html, body { margin: 0; background: #0e1512; }
#brand, #lead { color: #f4fff8; font-family: Syne, sans-serif; }
#brand { font-size: 64px; font-weight: 700; letter-spacing: -0.03em; line-height: 1; }
#lead { font-size: 20px; font-weight: 500; opacity: 0.9; }
#cta {
  background: #f4a259; color: #101820; font-family: Syne, sans-serif;
  font-weight: 700; font-size: 16px; border-radius: 0;
}
#out { color: #d7f5e6; font-family: Syne, sans-serif; font-size: 16px; }
#hero { filter: brightness(0.75); }
""")
raw "BEGIN STACK AT 0, 0 SIZE 1280, 720"
raw "SLOT IMAGE \"hero\" AT 0, 0 SIZE 1280, 720 FROM \"https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=2400&q=80\""
raw "END STACK"
raw "BEGIN COLUMN AT 48, 420 SIZE 1184, 280 PAD 0 GAP 16"
raw "SLOT TEXT \"brand\" SIZE 900, 80 SAY \"LukeLang\""
raw "SLOT TEXT \"lead\" SIZE 900, 48 SAY \"Hanka lays out. Argus paints.\""
raw "SLOT BUTTON \"cta\" SIZE 220, 48 SAY \"Lay out click\""
raw "SLOT TEXT \"out\" SIZE 640, 40 SAY \"\""
raw "END COLUMN"
raw "LAY OUT THE SCREEN"
raw "PAINT THE SCREEN"
raw """WHEN "cta" IS CLICKED DO
  BEGIN COLUMN AT 48, 420 SIZE 1184, 280 PAD 0 GAP 16
  SLOT TEXT "brand" SIZE 900, 80 SAY "LukeLang"
  SLOT TEXT "lead" SIZE 900, 48 SAY "Hanka laid this column."
  SLOT BUTTON "cta" SIZE 220, 48 SAY "Again"
  SLOT TEXT "out" SIZE 640, 40 SAY "Frames from Hanka → Argus."
  END COLUMN
  LAY OUT THE SCREEN
  PAINT THE SCREEN
END WHEN"""

IMPORT std/js

SPEAK "Luke browser JS bridge"
FILL "root" WITH """
<main style="font-family:Georgia,serif;padding:2rem">
  <p id="luke-status"></p>
  <div id="luke-panel"></div>
</main>
"""
ASK jsSetText WITH "luke-status", "Hello from Luke → DOM"
ASK jsSetHtml WITH "luke-panel", "<strong>Build</strong> · arena · no GC"

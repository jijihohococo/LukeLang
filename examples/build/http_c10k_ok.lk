import std/server
fn handle(req: Request) {
  let path = httpPath(req)
  let ip = httpClientIp(req)
  if path == "/ka" {
    httpReply(req, 200, "text/plain", "ka=" + ip)
    print("served=ka")
  }
  if path == "/chunk" {
    httpChunkOpen(req, 200, "text/plain")
    httpChunk(req, "hello ")
    httpChunk(req, "chunked")
    httpChunkEnd(req)
    print("served=chunk")
  }
  if path == "/ok" {
    httpReply(req, 200, "text/plain", "ok")
    print("served=ok")
  }
}
print("c10k :8804")
let server = httpListen(8804)
httpServe(server, handle, 1)
print("c10k_done=1")

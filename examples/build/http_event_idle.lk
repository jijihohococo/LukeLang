import std/server
fn handle(req: Request) {
  let path = httpPath(req)
  if path == "/fast" {
    httpReply(req, 200, "text/plain", "fast")
  }
  if path == "/ok" {
    httpReply(req, 200, "text/plain", "ok")
  }
}
print("event_idle :8806")
let server = httpListen(8806)
httpServe(server, handle, 0)
print("event_idle_done=1")

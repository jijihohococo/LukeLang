import std/http
import std/json
print("=== Build HTTP + JSON (local) ===")
let body: str = httpGet("http://127.0.0.1:8765/luke.json")
let empty: bool = body == ""
if empty {
  print("local server not running — skip")
}
if !empty {
  let doc: json = jsonParse(body)
  let greet: json = jsonGet(doc, "hello")
  print("json hello = " + jsonAsText(greet))
}
print("done")

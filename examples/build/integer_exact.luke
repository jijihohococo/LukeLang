var cents: int = 199
var id: int = 9007199254740993
var n: int = 0
n = n + 1
cents = cents + 1
id = id + 1
print("cents=" + cents)
print("id=" + id)
print("n=" + n)
if id == 9007199254740994 {
  print("exact=1")
}
signal rx_count: int = 10
rx_count = rx_count + 5
print("rx=" + rx_count)
assert cents == 200
assert n == 1
assert rx_count == 15

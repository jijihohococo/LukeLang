import std/sqlite
print("agg start")
let db = dbOpen("/tmp/luke_live_graph_agg.db")
dbExec(db, "PRAGMA journal_mode=WAL")
dbExec(db, "DROP TABLE IF EXISTS notes")
dbExec(db, "CREATE TABLE notes(id INTEGER PRIMARY KEY, status TEXT, body TEXT)")
dbExec(db, "INSERT INTO notes(id, status, body) VALUES(1, 'open', 'alpha')")
dbExec(db, "INSERT INTO notes(id, status, body) VALUES(2, 'open', 'beta')")
dbExec(db, "INSERT INTO notes(id, status, body) VALUES(3, 'closed', 'gamma')")
watch feed from db as "SELECT body FROM notes WHERE status = 'open'"
let v0: str = feed
print("v0=" + v0)
assert v0 == "alpha\nbeta"
dbExec(db, "UPDATE notes SET body = 'GAMMA' WHERE id = 3")
feed.refresh()
let vClosed: str = feed
print("vClosed=" + vClosed)
assert vClosed == "alpha\nbeta"
dbExec(db, "INSERT INTO notes(id, status, body) VALUES(4, 'open', 'delta')")
feed.refresh()
let v1: str = feed
print("v1=" + v1)
assert v1 == "alpha\nbeta\ndelta"
dbExec(db, "DELETE FROM notes WHERE id = 1")
feed.refresh()
let v2: str = feed
print("v2=" + v2)
assert v2 == "beta\ndelta"
dbExec(db, "UPDATE notes SET status = 'closed' WHERE id = 2")
feed.refresh()
let v3: str = feed
print("v3=" + v3)
assert v3 == "delta"
dbClose(db)
print("agg_ok=1")

// Regression: a WATCH with a NON-qualifiable filter (inequality `age > 30`) must
// not break writes to the base table. Such shapes fall back to ungated recompute
// (valid SQL) instead of the bag path, whose NEW./OLD. rewrite only fits `col = lit`.
// The maintained cell must equal a fresh recompute after inserts/updates/deletes.
// Build: luke BUILD examples/build/live_graph_agg_range.luke -o build/lgar

IMPORT std/sqlite

SPEAK "agg_range start"

MY NAME IS db SET TO ASK dbOpen WITH "/tmp/luke_live_graph_agg_range.db"
ASK dbExec WITH db, "DROP TABLE IF EXISTS people"
ASK dbExec WITH db, "CREATE TABLE people(id INTEGER PRIMARY KEY, name TEXT, age INTEGER)"
ASK dbExec WITH db, "INSERT INTO people(id, name, age) VALUES(1, 'Ada', 40)"
ASK dbExec WITH db, "INSERT INTO people(id, name, age) VALUES(2, 'Bo', 20)"

WATCH adults FROM db AS "SELECT name FROM people WHERE age > 30"

MY NAME IS v0 AS TEXT SET TO adults
SPEAK "v0=" AND v0
MAKE SURE v0 EQUALS "Ada"

// These writes must all take effect (the earlier bug rolled them back).
ASK dbExec WITH db, "INSERT INTO people(id, name, age) VALUES(3, 'Cy', 55)"
ASK dbExec WITH db, "UPDATE people SET age = 35 WHERE id = 2"
ASK dbExec WITH db, "DELETE FROM people WHERE id = 1"

// Independent proof the writes landed: row count reflects the delete + insert.
MY NAME IS cnt AS TEXT SET TO ASK dbQuery WITH db, "SELECT count(*) FROM people"
SPEAK "rowcount=" AND cnt
MAKE SURE cnt EQUALS "2"

REFRESH QUERY adults
MY NAME IS m AS TEXT SET TO adults
MY NAME IS truth AS TEXT SET TO ASK dbQuery WITH db, "SELECT group_concat(name, char(10)) FROM (SELECT name FROM people WHERE age > 30 ORDER BY rowid)"
SPEAK "maintained=[" AND m AND "] truth=[" AND truth AND "]"
MAKE SURE m EQUALS truth

ASK dbClose WITH db
SPEAK "agg_range_ok=1"

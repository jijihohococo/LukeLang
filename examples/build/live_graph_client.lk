import std/js
import std/hanka
import std/argus
page.title("Luke Live Graph")
page.style("""
html, body { margin: 0; background: #0e1512; color: #f4fff8; font-family: Georgia, serif; }
#brand { font-size: 40px; font-weight: 700; }
#name { font-size: 28px; }
#hint { font-size: 14px; opacity: 0.7; }
""")
signal user = ""
signal display = ""
signal history: list = []
signal region_now = 0
signal events = 0
signal replayed: float = 0
raw "BEGIN COLUMN AT 40, 40 SIZE 720, 200 PAD 0 GAP 14"
raw "SLOT TEXT \"brand\" SIZE AUTO, 48 SAY \"LukeLang\""
raw "SLOT TEXT \"name\" SIZE AUTO, 40 SAY \"name: —\""
raw "SLOT TEXT \"hint\" SIZE AUTO, 32 SAY \"Live Graph — DB row to pixel, zero glue.\""
raw "END COLUMN"
raw "LAY OUT THE SCREEN"
raw "PAINT THE SCREEN"
bind("name", display)
watch user from "http://127.0.0.1:8798/watch"
effect on user {
  history.push(user)
  if replayed == 0 {
    display = user
    if user == "Ada3" {
      batch {
        replayed = 1
        display = history[0]
      }
      print("replay=rewind0")
    }
  }
}
effect on display {
  region_now = region_paint_count
  print("region=" + region_now)
}
raw """WHEN WATCH user IS READY DO
  CHANGE events TO events ADD 1
  SPEAK "user=" AND user
  SPEAK "display=" AND display
  SPEAK "events=" AND events
  UPDATE "hint" WITH "live — region paints: " AND region_now
END WHEN"""

import std/sqlite
print("join_filter start")
let db = dbOpen("/tmp/luke_live_graph_join_filter.db")
dbExec(db, "PRAGMA journal_mode=WAL")
dbExec(db, "DROP TABLE IF EXISTS profiles")
dbExec(db, "DROP TABLE IF EXISTS users")
dbExec(db, "CREATE TABLE users(id INTEGER PRIMARY KEY, name TEXT, status TEXT)")
dbExec(db, "CREATE TABLE profiles(user_id INTEGER PRIMARY KEY, title TEXT)")
dbExec(db, "INSERT INTO users(id, name, status) VALUES(1, 'Ada', 'active')")
dbExec(db, "INSERT INTO profiles(user_id, title) VALUES(1, 'Engineer')")
watch card from db as "SELECT u.name || ' · ' || p.title FROM users u JOIN profiles p ON u.id = p.user_id WHERE u.status = 'active'"
let v0: str = card
print("v0=" + v0)
assert v0 == "Ada · Engineer"
dbExec(db, "INSERT INTO users(id, name, status) VALUES(2, 'Bob', 'inactive')")
dbExec(db, "INSERT INTO profiles(user_id, title) VALUES(2, 'Other')")
dbExec(db, "UPDATE users SET name = 'Bobby' WHERE id = 2")
dbExec(db, "UPDATE profiles SET title = 'Nope' WHERE user_id = 2")
card.refresh()
let vUn: str = card
print("vUn=" + vUn)
assert vUn == "Ada · Engineer"
dbExec(db, "UPDATE profiles SET title = 'Founder' WHERE user_id = 1")
card.refresh()
let v1: str = card
print("v1=" + v1)
assert v1 == "Ada · Founder"
dbExec(db, "UPDATE users SET status = 'retired' WHERE id = 1")
card.refresh()
let v2: str = card
print("v2=" + v2)
assert v2 == ""
dbExec(db, "UPDATE users SET status = 'active' WHERE id = 1")
card.refresh()
let v3: str = card
print("v3=" + v3)
assert v3 == "Ada · Founder"
dbClose(db)
print("join_filter_ok=1")

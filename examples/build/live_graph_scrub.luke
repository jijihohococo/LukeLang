import std/js
import std/hanka
import std/argus
page.title("Luke Live Graph Scrub")
page.style("""
html, body { margin: 0; background: #0f1410; color: #f3f8f1; font-family: "Iowan Old Style", Palatino, serif; }
#brand { font-size: 36px; }
#name { font-size: 26px; }
#meta { opacity: 0.7; font-size: 14px; }
""")
signal user = ""
signal display = ""
signal history: list = []
signal cursor: float = 0
signal hist_len: float = 0
signal scrubbing: float = 0
raw "BEGIN COLUMN AT 36, 32 SIZE 760, 280 PAD 0 GAP 14"
raw "SLOT TEXT \"brand\" SIZE AUTO, 48 SAY \"LukeLang\""
raw "SLOT TEXT \"name\" SIZE AUTO, 40 SAY \"display: —\""
raw "SLOT TEXT \"meta\" SIZE AUTO, 28 SAY \"scrub 0 / 0\""
raw "BEGIN ROW AT 0, 0 SIZE AUTO, 52 PAD 0 GAP 12"
raw "SLOT BUTTON \"back\" SIZE 120, 44 SAY \"◀ Back\""
raw "SLOT BUTTON \"fwd\" SIZE 120, 44 SAY \"Forward ▶\""
raw "SLOT BUTTON \"live\" SIZE 120, 44 SAY \"Live\""
raw "END ROW"
raw "END COLUMN"
raw "LAY OUT THE SCREEN"
raw "PAINT THE SCREEN"
bind("name", display)
watch user from "http://127.0.0.1:8798/watch"
effect on user {
  if scrubbing == 0 {
    history.push(user)
    hist_len = history.len()
    cursor = hist_len - 1
    display = user
  }
}
raw """WHEN "back" IS CLICKED DO
  IF cursor IS GREATER THAN 0 DO
    CHANGE scrubbing TO 1
    CHANGE cursor TO cursor SUBTRACT 1
    CHANGE display TO ITEM cursor OF history
    UPDATE "meta" WITH "scrub " AND cursor AND " / " AND hist_len
  END IF
END WHEN"""
raw """WHEN "fwd" IS CLICKED DO
  IF cursor IS LESS THAN hist_len SUBTRACT 1 DO
    CHANGE scrubbing TO 1
    CHANGE cursor TO cursor ADD 1
    CHANGE display TO ITEM cursor OF history
    UPDATE "meta" WITH "scrub " AND cursor AND " / " AND hist_len
  END IF
END WHEN"""
raw """WHEN "live" IS CLICKED DO
  CHANGE scrubbing TO 0
  IF hist_len IS GREATER THAN 0 DO
    CHANGE cursor TO hist_len SUBTRACT 1
    CHANGE display TO ITEM cursor OF history
  END IF
  UPDATE "meta" WITH "live · " AND hist_len AND " frames"
  SPEAK "scrub_live=1"
END WHEN"""
raw """WHEN WATCH user IS READY DO
  UPDATE "meta" WITH "live · " AND hist_len AND " frames"
  SPEAK "scrub_frame=" AND display
END WHEN"""
print("scrub_ok=1")

// DevTools scrub UI — scrub over client-buffered SSE history by seq index.
// Build: luke BUILD examples/build/live_graph_scrub.luke -target browser -o build/live_graph_scrub

IMPORT std/js
IMPORT std/hanka
IMPORT std/argus

NAME THE PAGE "Luke Live Graph Scrub"

WEAR STYLE """
html, body { margin: 0; background: #0f1410; color: #f3f8f1; font-family: "Iowan Old Style", Palatino, serif; }
#brand { font-size: 36px; }
#name { font-size: 26px; }
#meta { opacity: 0.7; font-size: 14px; }
"""

REMEMBER user AS ""
REMEMBER display AS ""
REMEMBER history AS LIST
REMEMBER cursor AS NUMBER SET TO 0
REMEMBER hist_len AS NUMBER SET TO 0
REMEMBER scrubbing AS NUMBER SET TO 0

BEGIN COLUMN AT 36, 32 SIZE 760, 280 PAD 0 GAP 14
  SLOT TEXT "brand" SIZE AUTO, 48 SAY "LukeLang"
  SLOT TEXT "name" SIZE AUTO, 40 SAY "display: —"
  SLOT TEXT "meta" SIZE AUTO, 28 SAY "scrub 0 / 0"
  BEGIN ROW AT 0, 0 SIZE AUTO, 52 PAD 0 GAP 12
    SLOT BUTTON "back" SIZE 120, 44 SAY "◀ Back"
    SLOT BUTTON "fwd" SIZE 120, 44 SAY "Forward ▶"
    SLOT BUTTON "live" SIZE 120, 44 SAY "Live"
  END ROW
END COLUMN

LAY OUT THE SCREEN
PAINT THE SCREEN

BIND "name" TO display

WATCH user FROM "http://127.0.0.1:8798/watch"

WHEN REACTIVE user CHANGES DO
  IF scrubbing EQUALS 0 DO
    ADD user TO history
    CHANGE hist_len TO HOW MANY IN history
    CHANGE cursor TO hist_len SUBTRACT 1
    CHANGE display TO user
  END IF
END WHEN REACTIVE

WHEN "back" IS CLICKED DO
  IF cursor IS GREATER THAN 0 DO
    CHANGE scrubbing TO 1
    CHANGE cursor TO cursor SUBTRACT 1
    CHANGE display TO ITEM cursor OF history
    UPDATE "meta" WITH "scrub " AND cursor AND " / " AND hist_len
  END IF
END WHEN

WHEN "fwd" IS CLICKED DO
  IF cursor IS LESS THAN hist_len SUBTRACT 1 DO
    CHANGE scrubbing TO 1
    CHANGE cursor TO cursor ADD 1
    CHANGE display TO ITEM cursor OF history
    UPDATE "meta" WITH "scrub " AND cursor AND " / " AND hist_len
  END IF
END WHEN

WHEN "live" IS CLICKED DO
  CHANGE scrubbing TO 0
  IF hist_len IS GREATER THAN 0 DO
    CHANGE cursor TO hist_len SUBTRACT 1
    CHANGE display TO ITEM cursor OF history
  END IF
  UPDATE "meta" WITH "live · " AND hist_len AND " frames"
  SPEAK "scrub_live=1"
END WHEN

WHEN WATCH user IS READY DO
  UPDATE "meta" WITH "live · " AND hist_len AND " frames"
  SPEAK "scrub_frame=" AND display
END WHEN

SPEAK "scrub_ok=1"

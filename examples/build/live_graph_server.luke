// Live Graph spike 1 — DB row → SSE (server-side CDC poll)
// External UPDATE on SQLite → poll notices → httpSseData → wire.
// Build: luke BUILD examples/build/live_graph_server.luke -o build/live_graph_server

IMPORT std/server
IMPORT std/sqlite
IMPORT std/argus

SPEAK "live_graph server :8798 /watch"

MY NAME IS db SET TO ASK dbOpen WITH "/tmp/luke_live_graph.db"
ASK dbExec WITH db, "PRAGMA journal_mode=WAL"
ASK dbExec WITH db, "CREATE TABLE IF NOT EXISTS users(id INTEGER PRIMARY KEY, name TEXT)"
ASK dbExec WITH db, "DELETE FROM users"
ASK dbExec WITH db, "INSERT INTO users(id, name) VALUES(1, 'seed')"

MY NAME IS server SET TO ASK httpListen WITH 8798
MY NAME IS left AS NUMBER SET TO 4

WHILE left IS GREATER THAN 0 DO
  MY NAME IS req SET TO ASK httpAccept WITH server
  MY NAME IS path SET TO ASK httpPath WITH req
  MY NAME IS hit AS FLAG SET TO FALSE
  IF path EQUALS "/watch" DO
    SET hit TO TRUE
    ASK httpSseOpen WITH req
    MY NAME IS last AS TEXT SET TO ""
    MY NAME IS beats AS NUMBER SET TO 0
    WHILE beats IS LESS THAN 50 DO
      SET beats TO beats ADD 1
      MY NAME IS name SET TO ASK dbQuery WITH db, "SELECT name FROM users WHERE id = 1"
      MY NAME IS same AS FLAG SET TO name EQUALS last
      IF NOT same DO
        SET last TO name
        ASK httpSseData WITH req, name
        SPEAK "row=" AND name
      END IF
      ASK httpSseComment WITH req, "cdc"
      MY NAME IS t0 AS NUMBER SET TO THE CLOCK
      WHILE THE CLOCK SUBTRACT t0 IS LESS THAN 50 DO
      END WHILE
    END WHILE
    ASK httpClose WITH req
  END IF
  IF NOT hit DO
    ASK httpReply WITH req, 404, "text/plain", "not found"
  END IF
  SET left TO left SUBTRACT 1
END WHILE

ASK dbClose WITH db
SPEAK "server done"

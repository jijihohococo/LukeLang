struct Animal {
  name: str
  sound = "..."
  init(name: str) {
    self.name = name
  }
  fn speak() {
    print(self.name + " says " + self.sound)
  }
  fn eat(food: str) {
    print(self.name + " eats " + food)
  }
}
struct Dog : Animal {
  sound = "Woof!"
  fn speak() {
    super.speak()
    print(self.name + " wags happily.")
  }
  fn fetch(toy: str) {
    print(self.name + " fetches the " + toy)
  }
}
raw "SET buddy TO NEW Dog WITH \"Rex\""

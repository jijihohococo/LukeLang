import std/server
import std/pg
let setup = pgOpen("host=127.0.0.1 port=5432 dbname=luke user=luke password=luke")
var none: list = []
pgExecBind(setup, "DROP TABLE IF EXISTS users", none)
pgExecBind(setup, "CREATE TABLE users(id INTEGER PRIMARY KEY, name TEXT)", none)
var s1: list = []
s1.push("1")
s1.push("Ada")
pgExecBind(setup, "INSERT INTO users(id, name) VALUES($1, $2)", s1)
var s2: list = []
s2.push("2")
s2.push("Bo")
pgExecBind(setup, "INSERT INTO users(id, name) VALUES($1, $2)", s2)
var s3: list = []
s3.push("3")
s3.push("Cy")
pgExecBind(setup, "INSERT INTO users(id, name) VALUES($1, $2)", s3)
pgClose(setup)
fn handle(req: Request) {
  let pg = pgOpen("host=127.0.0.1 port=5432 dbname=luke user=luke password=luke")
  let path = httpPath(req)
  var params: map = {}
  var answered: bool = false
  if httpMatch(path, "/user/:id", params) {
    let id = params["id"]
    var binds: list = []
    binds.push(id)
    let name = pgQueryBind(pg, "SELECT name FROM users WHERE id = $1", binds)
    httpReply(req, 200, "text/plain", name)
    answered = true
  }
  if !answered {
    if path == "/ok" {
      httpReply(req, 200, "text/plain", "ok")
      answered = true
    }
  }
  if !answered {
    httpReply(req, 404, "text/plain", "missing")
  }
  pgClose(pg)
}
print("pg_api :8811")
let server = httpListen(8811)
httpServe(server, handle, 0)
print("pg_api_done=1")

// Track 12 — granular paint vs full rebuild (median / min harness)
// Warmup, then 100× granular samples; 20× full-rebuild samples.
// Build: luke BUILD examples/build/reactive_benchmark.luke -o build/reactive_benchmark

IMPORT std/hanka
IMPORT std/argus

MY NAME IS run AS NUMBER SET TO 0
WHILE run IS LESS THAN 2 DO
  MY NAME IS n AS NUMBER SET TO 1000
  IF run EQUALS 1 DO
    SET n TO 10000
  END IF

  CLEAR THE SCREEN

  MY NAME IS i AS NUMBER SET TO 0
  MY NAME IS t_build0 AS NUMBER SET TO THE CLOCK
  WHILE i IS LESS THAN n DO
    PLACE "n" AND i AS TEXT AT 0, 0 SIZE 40, 12 SAY "row"
    SET i TO i ADD 1
  END WHILE
  PAINT THE SCREEN
  MY NAME IS t_build1 AS NUMBER SET TO THE CLOCK
  MY NAME IS build_ms AS NUMBER SET TO t_build1 SUBTRACT t_build0

  MY NAME IS w AS NUMBER SET TO 0
  WHILE w IS LESS THAN 5 DO
    UPDATE "n0" WITH "warm" AND w
    SET w TO w ADD 1
  END WHILE

  RESET THE BENCH
  MY NAME IS paints_before AS NUMBER SET TO THE REGION PAINT COUNT
  MY NAME IS r AS NUMBER SET TO 0
  WHILE r IS LESS THAN 100 DO
    MY NAME IS t_g0 AS NUMBER SET TO THE CLOCK
    UPDATE "n0" WITH "hit" AND r
    MY NAME IS t_g1 AS NUMBER SET TO THE CLOCK
    RECORD BENCH SAMPLE t_g1 SUBTRACT t_g0
    SET r TO r ADD 1
  END WHILE
  MY NAME IS granular_med AS NUMBER SET TO THE BENCH MEDIAN
  MY NAME IS granular_min AS NUMBER SET TO THE BENCH MIN
  MY NAME IS region AS NUMBER SET TO THE REGION PAINT COUNT SUBTRACT paints_before
  MY NAME IS g_samples AS NUMBER SET TO THE BENCH SAMPLE COUNT

  RESET THE BENCH
  MY NAME IS f AS NUMBER SET TO 0
  WHILE f IS LESS THAN 20 DO
    MY NAME IS t_f0 AS NUMBER SET TO THE CLOCK
    CLEAR THE SCREEN
    SET i TO 0
    WHILE i IS LESS THAN n DO
      PLACE "n" AND i AS TEXT AT 0, 0 SIZE 40, 12 SAY "row"
      SET i TO i ADD 1
    END WHILE
    PAINT THE SCREEN
    MY NAME IS t_f1 AS NUMBER SET TO THE CLOCK
    RECORD BENCH SAMPLE t_f1 SUBTRACT t_f0
    SET f TO f ADD 1
  END WHILE
  MY NAME IS full_med AS NUMBER SET TO THE BENCH MEDIAN
  MY NAME IS full_min AS NUMBER SET TO THE BENCH MIN
  MY NAME IS f_samples AS NUMBER SET TO THE BENCH SAMPLE COUNT

  SPEAK "nodes=" AND n
  SPEAK "build_ms=" AND build_ms
  SPEAK "granular_median_ms=" AND granular_med
  SPEAK "granular_min_ms=" AND granular_min
  SPEAK "granular_samples=" AND g_samples
  SPEAK "full_median_ms=" AND full_med
  SPEAK "full_min_ms=" AND full_min
  SPEAK "full_samples=" AND f_samples
  SPEAK "region=" AND region

  MAKE SURE region EQUALS 100
  MAKE SURE g_samples EQUALS 100
  MAKE SURE f_samples EQUALS 20

  SET run TO run ADD 1
END WHILE

SPEAK "benchmark_ok=1"

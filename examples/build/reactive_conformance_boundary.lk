signal global_ok = 0
raw "BEGIN ERROR BOUNDARY Panel"
raw "BEGIN COMPONENT Box"
signal x = 1
raw "END COMPONENT"
effect on x {
  try {
    throw "boom"
  }
}
raw "THE inner IS x ADD 10"
effect on inner {
  global_ok = 99
}
raw "END ERROR BOUNDARY Panel"
effect on x {
  global_ok = 1
}
x += 1
print("global=" + global_ok)
raw "SPEAK \"trips=\" AND THE BOUNDARY TRIP COUNT"
raw "SPEAK \"tripped=\" AND THE BOUNDARY TRIPPED FOR Panel"
raw "RESET ERROR BOUNDARY Panel"
raw "SPEAK \"reset=\" AND THE BOUNDARY TRIPPED FOR Panel"

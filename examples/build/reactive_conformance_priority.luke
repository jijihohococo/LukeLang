// Phase 10 — Scheduler 2.0 priority lanes
// UI-priority reactive effects run before BACKGROUND effects.

REMEMBER x AS 0
REMEMBER log AS 0

WHEN BACKGROUND REACTIVE x CHANGES DO
  CHANGE log TO log MULTIPLIED BY 10
END WHEN REACTIVE

WHEN REACTIVE x CHANGES DO
  INCREASE log BY 1
END WHEN REACTIVE

CHANGE x TO 1
SPEAK "log=" AND log
SPEAK "ui_first=" AND THE SCHEDULER UI BEFORE BACKGROUND

raw "BEGIN COMPONENT A"
signal a = 1
raw "END COMPONENT"
raw "UNMOUNT COMPONENT A"
raw "BEGIN COMPONENT B"
signal b = 2
raw "END COMPONENT"
raw "UNMOUNT COMPONENT B"
raw "SPEAK \"scopes=\" AND THE SCOPE FRAME COUNT"
raw "SPEAK \"gc=\" AND THE SCOPE GC COUNT"
raw "SPEAK \"alive=\" AND THE ALIVE NODE COUNT"
raw "SPEAK \"dead=\" AND THE DEAD NODE COUNT"

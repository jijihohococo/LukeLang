raw "BEGIN COMPONENT Box"
signal x = 10
raw "END COMPONENT"
effect weak on x {
  print("tick")
}
x += 1
raw "UNMOUNT COMPONENT Box"
raw "AUDIT REACTIVE"
raw "SPEAK \"leaks=\" AND THE LEAK EDGE COUNT"
raw "SPEAK \"alive=\" AND THE ALIVE NODE COUNT"
raw "SPEAK \"weak_reads=\" AND THE WEAK READ COUNT"

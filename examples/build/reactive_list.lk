signal players: list = []
signal scores: map = {}
bind.list(players, "row")
players.push("Ada")
players.push("Bea")
print("n=" + players.len())
print("i0=" + players[0])
print("i1=" + players[1])
signal paints_before = 0
paints_before = granular_paint_count
players[1] = "Zoe"
print("item=" + players[1])
signal paints_delta = 0
paints_delta = granular_paint_count - paints_before
print("delta=" + paints_delta)
scores["Ada"] = "10"
scores["Zoe"] = "12"
print("Ada=" + scores["Ada"])
print("mapn=" + scores.len())
for name in players {
  print("fe=" + name)
}

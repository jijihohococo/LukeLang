import std/hanka
import std/argus
let n: float = 100000
raw "CLEAR THE SCREEN"
var i: float = 0
let t_build0: float = clock
while i < n {
  raw "PLACE \"n\" AND i AS TEXT AT 0, 0 SIZE 40, 12 SAY \"row\""
  i = i + 1
}
raw "PAINT THE SCREEN"
let t_build1: float = clock
let build_ms: float = t_build1 - t_build0
var w: float = 0
while w < 5 {
  raw "UPDATE \"n0\" WITH \"warm\" AND w"
  w = w + 1
}
raw "RESET THE BENCH"
let paints_before: float = region_paint_count
var r: float = 0
while r < 50 {
  let t_g0: float = clock
  raw "UPDATE \"n0\" WITH \"hit\" AND r"
  let t_g1: float = clock
  raw "RECORD BENCH SAMPLE t_g1 SUBTRACT t_g0"
  r = r + 1
}
let granular_med: float = bench_median
let granular_min: float = bench_min
let region: float = region_paint_count - paints_before
let g_samples: float = bench_sample_count
raw "RESET THE BENCH"
var f: float = 0
while f < 5 {
  let t_f0: float = clock
  raw "CLEAR THE SCREEN"
  i = 0
  while i < n {
    raw "PLACE \"n\" AND i AS TEXT AT 0, 0 SIZE 40, 12 SAY \"row\""
    i = i + 1
  }
  raw "PAINT THE SCREEN"
  let t_f1: float = clock
  raw "RECORD BENCH SAMPLE t_f1 SUBTRACT t_f0"
  f = f + 1
}
let full_med: float = bench_median
let full_min: float = bench_min
let f_samples: float = bench_sample_count
print("pressure=reactive")
print("nodes=" + n)
print("build_ms=" + build_ms)
print("granular_median_ms=" + granular_med)
print("granular_min_ms=" + granular_min)
print("granular_samples=" + g_samples)
print("full_median_ms=" + full_med)
print("full_min_ms=" + full_min)
print("full_samples=" + f_samples)
print("region=" + region)
assert region == 50
assert g_samples == 50
assert f_samples == 5
print("pressure_ok=1")

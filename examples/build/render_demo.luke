// Compatibility alias — use argus_demo.luke
// Build: luke BUILD examples/build/argus_demo.luke -target browser -o build/argus_demo

IMPORT std/js
IMPORT std/argus

NAME THE PAGE "Argus"

PLACE "brand" AS TEXT AT 48, 420 SIZE 900, 80 SAY "LukeLang"
PLACE "lead" AS TEXT AT 48, 510 SIZE 640, 80 SAY "Argus — use examples/build/argus_demo.luke"
PAINT THE SCREEN

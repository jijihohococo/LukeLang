import std/sqlite
print("sql_bind start")
let db = dbOpen("/tmp/luke_sql_bind.db")
dbExec(db, "DROP TABLE IF EXISTS users")
dbExec(db, "CREATE TABLE users(id INTEGER PRIMARY KEY, name TEXT)")
var seed: list = []
seed.push("1")
seed.push("Ada")
dbExecBind(db, "INSERT INTO users(id, name) VALUES(?, ?)", seed)
var evil: list = []
evil.push("2")
evil.push("Bobby'); DROP TABLE users;--")
dbExecBind(db, "INSERT INTO users(id, name) VALUES(?, ?)", evil)
var q1: list = []
q1.push("1")
let name1 = dbQueryBind(db, "SELECT name FROM users WHERE id = ?", q1)
print("name1=" + name1)
var q2: list = []
q2.push("2")
let name2 = dbQueryBind(db, "SELECT name FROM users WHERE id = ?", q2)
print("name2=" + name2)
let count = dbQuery(db, "SELECT COUNT(*) FROM users")
print("count=" + count)
assert name1 == "Ada"
assert name2 == "Bobby'); DROP TABLE users;--"
assert count == "2"
dbClose(db)
print("sql_bind_ok=1")

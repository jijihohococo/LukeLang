import std/server
import std/argus
print("subscribe_cell server :8793 /events")
let server = httpListen(8793)
var left: float = 6
while left > 0 {
  let req = httpAccept(server)
  let path = httpPath(req)
  var hit: bool = false
  if path == "/events" {
    hit = true
    httpSseOpen(req)
    var n: float = 0
    while n < 8 {
      n = n + 1
      httpSseComment(req, "beat")
      httpSseData(req, "" + n)
      print("push=" + n)
      let t0: float = clock
      while clock - t0 < 40 {
      }
    }
    httpClose(req)
  }
  if !hit {
    httpReply(req, 404, "text/plain", "not found")
  }
  left = left - 1
}
print("server done")

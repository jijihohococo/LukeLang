import std/args
import std/env
import std/paths
print("=== Luke tooling ===")
print("args =")
print(argCount())
print("cwd = " + cwd())
print("joined = " + pathJoin("/tmp", "luke.txt"))
print("base = " + pathBasename("/tmp/luke.txt"))
let home: str = getEnv("HOME")
let missing: bool = home == ""
if missing {
  print("HOME not set")
}
if !missing {
  print("HOME is set")
}
print("tooling beachhead ready")

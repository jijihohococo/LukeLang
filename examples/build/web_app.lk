import std/js
import std/hanka
import std/argus
import std/web
page.title("Luke Web")
page.font("Syne", "https://fonts.googleapis.com/css2?family=Syne:wght@700&display=swap")
page.style("""
html, body { margin: 0; background: #0e1512; color: #f4fff8; font-family: Syne, sans-serif; }
#title, #lead, #status, #row0, #row1, #row2, #out { color: #f4fff8; }
#title { font-size: 44px; font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; }
#lead, #status, #out, #row0, #row1, #row2 { font-size: 17px; opacity: 0.92; }
#nav-home, #nav-search, #nav-account, #search-go, #account-go, #load {
  background: #f4a259; color: #101820; font-family: Syne, sans-serif;
  font-weight: 700; font-size: 14px; cursor: pointer;
}
#q, #email, #pass {
  background: #1a2420; color: #f4fff8; font-family: Syne, sans-serif;
  font-size: 16px; border: 1px solid #2f4038;
}
""")
fn paintNav() {
  raw "BEGIN ROW AT 0, 0 SIZE 720, 48 PAD 0 GAP 12"
  raw "SLOT BUTTON \"nav-home\" SIZE 120, 44 SAY \"Home\""
  raw "SLOT BUTTON \"nav-search\" SIZE 120, 44 SAY \"Search\""
  raw "SLOT BUTTON \"nav-account\" SIZE 140, 44 SAY \"Account\""
  raw "END ROW"
}
fn showHome() {
  raw "CLEAR THE SCREEN"
  raw "BEGIN COLUMN AT 48, 48 SIZE 720, 520 PAD 0 GAP 16"
  paintNav()
  raw "SLOT TEXT \"title\" SIZE 640, 56 SAY \"LukeLang\""
  raw "SLOT TEXT \"lead\" SIZE 640, 48 SAY \"Production v1 — nested layout, lists, async fetch.\""
  raw "SLOT BUTTON \"load\" SIZE 200, 44 SAY \"Load sample list\""
  raw "SLOT TEXT \"status\" SIZE 640, 36 SAY \"\""
  raw "SLOT TEXT \"row0\" SIZE 640, 32 SAY \"\""
  raw "SLOT TEXT \"row1\" SIZE 640, 32 SAY \"\""
  raw "SLOT TEXT \"row2\" SIZE 640, 32 SAY \"\""
  raw "END COLUMN"
  raw "LAY OUT THE SCREEN"
  raw "PAINT THE SCREEN"
}
fn showSearch() {
  raw "CLEAR THE SCREEN"
  raw "BEGIN COLUMN AT 48, 48 SIZE 720, 420 PAD 0 GAP 16"
  paintNav()
  raw "SLOT TEXT \"title\" SIZE 640, 56 SAY \"Search\""
  raw "SLOT INPUT \"q\" SIZE 480, 48 SAY \"Query…\""
  raw "SLOT BUTTON \"search-go\" SIZE 140, 48 SAY \"Search\""
  raw "SLOT TEXT \"out\" SIZE 640, 40 SAY \"\""
  raw "SLOT TEXT \"status\" SIZE 640, 36 SAY \"\""
  raw "END COLUMN"
  raw "LAY OUT THE SCREEN"
  raw "PAINT THE SCREEN"
}
fn showAccount() {
  raw "CLEAR THE SCREEN"
  raw "BEGIN COLUMN AT 48, 48 SIZE 720, 420 PAD 0 GAP 16"
  paintNav()
  raw "SLOT TEXT \"title\" SIZE 640, 56 SAY \"Account\""
  raw "SLOT INPUT \"email\" AS EMAIL SIZE 480, 48 SAY \"you@example.com\""
  raw "SLOT INPUT \"pass\" AS PASSWORD SIZE 480, 48 SAY \"Password\""
  raw "SLOT BUTTON \"account-go\" SIZE 160, 48 SAY \"Validate\""
  raw "SLOT TEXT \"out\" SIZE 640, 40 SAY \"\""
  raw "END COLUMN"
  raw "LAY OUT THE SCREEN"
  raw "PAINT THE SCREEN"
}
fn paintList(items: list) {
  var i: float
  i = 0
  for item in items {
    if i == 0 {
      raw "PLACE \"row0\" AS TEXT AT 48, 280 SIZE 640, 32 SAY item"
    }
    if i == 1 {
      raw "PLACE \"row1\" AS TEXT AT 48, 316 SIZE 640, 32 SAY item"
    }
    if i == 2 {
      raw "PLACE \"row2\" AS TEXT AT 48, 352 SIZE 640, 32 SAY item"
    }
    i = i + 1
  }
  raw "PAINT THE SCREEN"
}
raw "GO TO \"home\""
showHome()
raw """WHEN THE ROUTE IS "home" DO
  ASK showHome
END WHEN"""
raw """WHEN THE ROUTE IS "search" DO
  ASK showSearch
END WHEN"""
raw """WHEN THE ROUTE IS "account" DO
  ASK showAccount
END WHEN"""
raw """WHEN "nav-home" IS CLICKED DO
  GO TO "home"
END WHEN"""
raw """WHEN "nav-search" IS CLICKED DO
  GO TO "search"
END WHEN"""
raw """WHEN "nav-account" IS CLICKED DO
  GO TO "account"
END WHEN"""
raw """WHEN "load" IS CLICKED DO
  PLACE "status" AS TEXT AT 48, 240 SIZE 640, 36 SAY "Fetching…"
  PAINT THE SCREEN
  START FETCH "demo" GET "https://httpbin.org/get"
END WHEN"""
raw """WHEN FETCH "demo" IS READY DO
  MY NAME IS st AS NUMBER
  SET st TO THE STATUS OF FETCH "demo"
  MY NAME IS body AS TEXT
  SET body TO THE BODY OF FETCH "demo"
  PLACE "status" AS TEXT AT 48, 240 SIZE 640, 36 SAY "Fetch done."
  MY NAME IS items AS LIST
  ADD "status ok" TO items
  ADD body TO items
  ADD "still LukeLang" TO items
  ASK paintList WITH items
END WHEN"""
raw """WHEN "search-go" IS CLICKED DO
  MY NAME IS q AS TEXT
  SET q TO THE VALUE OF "q"
  PLACE "out" AS TEXT AT 48, 280 SIZE 640, 40 SAY q
  PLACE "status" AS TEXT AT 48, 328 SIZE 640, 36 SAY "Search path."
  PAINT THE SCREEN
END WHEN"""
raw """WHEN "account-go" IS CLICKED DO
  MY NAME IS email AS TEXT
  SET email TO THE VALUE OF "email"
  MY NAME IS pass AS TEXT
  SET pass TO THE VALUE OF "pass"
  IF ASK looksLikeEmail WITH email DO
    IF ASK textNonempty WITH pass DO
      PLACE "out" AS TEXT AT 48, 280 SIZE 640, 40 SAY "Account looks valid."
    END IF
    IF NOT ASK textNonempty WITH pass DO
      PLACE "out" AS TEXT AT 48, 280 SIZE 640, 40 SAY "Password needed."
    END IF
  END IF
  IF NOT ASK looksLikeEmail WITH email DO
    PLACE "out" AS TEXT AT 48, 280 SIZE 640, 40 SAY "Email looks wrong."
  END IF
  PAINT THE SCREEN
END WHEN"""

// Production web beachhead — Hanka + Argus + inputs + hash routes
// Build: luke BUILD examples/build/web_app.luke -target browser -o build/web_app

IMPORT std/js
IMPORT std/hanka
IMPORT std/argus

NAME THE PAGE "Luke Web"

BRING FONT "Syne" FROM "https://fonts.googleapis.com/css2?family=Syne:wght@700&display=swap"

WEAR STYLE """
html, body { margin: 0; background: #0e1512; color: #f4fff8; font-family: Syne, sans-serif; }
#title, #lead, #out, #result { color: #f4fff8; }
#title { font-size: 48px; font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; }
#lead, #out, #result { font-size: 18px; opacity: 0.92; }
#to-home, #to-search, #go {
  background: #f4a259; color: #101820; font-family: Syne, sans-serif;
  font-weight: 700; font-size: 15px; cursor: pointer;
}
#q {
  background: #1a2420; color: #f4fff8; font-family: Syne, sans-serif;
  font-size: 16px; border: 1px solid #2f4038;
}
"""

THIS IS FUNCTION showHome DO
  CLEAR THE SCREEN
  BEGIN COLUMN AT 48, 48 SIZE 720, 360 PAD 0 GAP 20
    SLOT TEXT "title" SIZE 640, 64 SAY "LukeLang"
    SLOT TEXT "lead" SIZE 640, 48 SAY "Production web beachhead — routes, forms, Hanka → Argus."
    SLOT BUTTON "to-search" SIZE 200, 48 SAY "Go to search"
  END COLUMN
  LAY OUT THE SCREEN
  PAINT THE SCREEN
END FUNCTION

THIS IS FUNCTION showSearch DO
  CLEAR THE SCREEN
  BEGIN COLUMN AT 48, 48 SIZE 720, 400 PAD 0 GAP 16
    SLOT TEXT "title" SIZE 640, 56 SAY "Search"
    SLOT INPUT "q" SIZE 480, 48 SAY "Type a query…"
    SLOT BUTTON "go" SIZE 140, 48 SAY "Search"
    SLOT BUTTON "to-home" SIZE 140, 48 SAY "Home"
    SLOT TEXT "out" SIZE 640, 40 SAY ""
    SLOT TEXT "result" SIZE 640, 40 SAY ""
  END COLUMN
  LAY OUT THE SCREEN
  PAINT THE SCREEN
END FUNCTION

GO TO "home"
ASK showHome

WHEN THE ROUTE IS "home" DO
  ASK showHome
END WHEN

WHEN THE ROUTE IS "search" DO
  ASK showSearch
END WHEN

WHEN "to-search" IS CLICKED DO
  GO TO "search"
END WHEN

WHEN "to-home" IS CLICKED DO
  GO TO "home"
END WHEN

WHEN "go" IS CLICKED DO
  MY NAME IS q AS TEXT
  SET q TO THE VALUE OF "q"
  PLACE "out" AS TEXT AT 48, 280 SIZE 640, 40 SAY q
  PLACE "result" AS TEXT AT 48, 328 SIZE 640, 40 SAY "Still LukeLang — no app JS."
  PAINT THE SCREEN
END WHEN

WHEN "q" IS SUBMITTED DO
  MY NAME IS q AS TEXT
  SET q TO THE VALUE OF "q"
  PLACE "out" AS TEXT AT 48, 280 SIZE 640, 40 SAY q
  PLACE "result" AS TEXT AT 48, 328 SIZE 640, 40 SAY "Submitted from the field."
  PAINT THE SCREEN
END WHEN

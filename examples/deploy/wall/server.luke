// Wall sentence proof — one deployed Live Graph app (DB → SSE → pixel).
// Serve behind Caddy (see Caddyfile). Binary listens on 8800.
// Build: luke BUILD examples/deploy/wall/server.luke -o build/wall_server

IMPORT std/server
IMPORT std/sqlite
IMPORT std/argus

SPEAK "wall server :8800 /watch"

MY NAME IS db SET TO ASK dbOpen WITH "/tmp/luke_wall.db"
ASK dbExec WITH db, "PRAGMA journal_mode=WAL"
ASK dbExec WITH db, "CREATE TABLE IF NOT EXISTS users(id INTEGER PRIMARY KEY, name TEXT)"
ASK dbExec WITH db, "DELETE FROM users"
ASK dbExec WITH db, "INSERT INTO users(id, name) VALUES(1, 'seed')"

WATCH user FROM db WHERE "id = 1"

MY NAME IS server SET TO ASK httpListen WITH 8800
MY NAME IS left AS NUMBER SET TO 8

WHILE left IS GREATER THAN 0 DO
  MY NAME IS req SET TO ASK httpAccept WITH server
  MY NAME IS path SET TO ASK httpPath WITH req
  MY NAME IS hit AS FLAG SET TO FALSE
  IF path EQUALS "/watch" DO
    SET hit TO TRUE
    PUSH WATCH user ON req FOR 40 BEATS EVERY 50 MILLISECONDS
  END IF
  IF path EQUALS "/health" DO
    SET hit TO TRUE
    ASK httpReply WITH req, 200, "text/plain", "ok"
  END IF
  IF hit EQUALS FALSE DO
    ASK httpReply WITH req, 404, "text/plain", "not found"
  END IF
  SET left TO left SUBTRACT 1
END WHILE

ASK dbClose WITH db
SPEAK "wall_server_done=1"

import std/server
import std/sqlite
import std/argus
print("wall server :8800 /watch")
let db = dbOpen("/tmp/luke_wall.db")
dbExec(db, "PRAGMA journal_mode=WAL")
dbExec(db, "CREATE TABLE IF NOT EXISTS users(id INTEGER PRIMARY KEY, name TEXT)")
dbExec(db, "DELETE FROM users")
dbExec(db, "INSERT INTO users(id, name) VALUES(1, 'seed')")
watch user from db where "id = 1"
let server = httpListen(8800)
var left: float = 8
while left > 0 {
  let req = httpAccept(server)
  let path = httpPath(req)
  var hit: bool = false
  if path == "/watch" {
    hit = true
    push watch user on req for 40 beats every 50 ms
  }
  if path == "/health" {
    hit = true
    httpReply(req, 200, "text/plain", "ok")
  }
  if hit == false {
    httpReply(req, 404, "text/plain", "not found")
  }
  left = left - 1
}
dbClose(db)
print("wall_server_done=1")

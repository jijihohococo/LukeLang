// Nested functions with upvalue capture (closures).

fn makeCounter(start: float) {
  var n: float = start
  fn tick() -> float {
    n = n + 1
    return n
  }
  return tick
}

fn makeAdder(x: float) {
  fn add(y: float) -> float {
    return x + y
  }
  return add
}

let counter = makeCounter(0)
print("tick: " + counter())
print("tick: " + counter())
print("tick: " + counter())

let addTen = makeAdder(10)
print("10 + 5 = " + addTen(5))
print("10 + 7 = " + addTen(7))

// Native LukeLang functions — own call frames, no JS.

fn add(a: float, b: float) -> float {
  return a + b
}

fn greet(name: str) -> str {
  print("Hello, " + name + "!")
  return name
}

fn factorial(n: float) -> float {
  if n < 2 {
    return 1
  }
  let prev = factorial(n - 1)
  return n * prev
}

print("2 + 3 =")
print(add(2, 3))

greet("Luke")

print("5! =")
print(factorial(5))

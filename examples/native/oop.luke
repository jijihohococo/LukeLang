// Native LukeLang OOP — blueprints on the Luke heap (no JavaScript).

struct Animal {
  name: str
  sound = "..."
  init(name: str) {
    self.name = name
  }
  fn speak() {
    print(self.name + " says " + self.sound)
  }
  fn eat(food: str) {
    print(self.name + " eats " + food)
  }
}

struct Dog : Animal {
  sound = "Woof!"
  fn speak() {
    super.speak()
    print(self.name + " wags happily.")
  }
  fn fetch(toy: str) {
    print(self.name + " fetches the " + toy)
  }
}

struct Cat : Animal {
  sound = "Meow!"
  fn speak() {
    print(self.name + " lazily says " + self.sound)
  }
}

raw "SET buddy TO NEW Dog WITH \"Rex\""
buddy.speak()
buddy.eat("kibble")
buddy.fetch("ball")

raw "SET mittens TO NEW Cat WITH \"Mittens\""
mittens.speak()
mittens.eat("tuna")

print("buddy is " + buddy)
print("Done — instances live on the Luke heap.")

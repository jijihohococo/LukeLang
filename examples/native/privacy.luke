// Privacy: outside code must not read PRIVATE fields or call SECRET methods.

struct Vault {
  secret: str
  label = "vault"
  init(secret: str) {
    self.secret = secret
  }
  private fn raw() -> str {
    return self.secret
  }
  fn reveal() -> str {
    return self.raw()
  }
}

raw "SET v TO NEW Vault WITH \"gold\""
print("label: " + v.label)
print("reveal: " + v.reveal())

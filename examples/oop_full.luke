print("=== OOP Feature Showcase ===")
raw "CONTRACT Movable DO"
raw "MUST METHOD move WITH distance"
raw "END CONTRACT"
raw "CONTRACT Eater DO"
raw "MUST METHOD eat WITH food"
raw "END CONTRACT"
raw "CONTRACT Sleeper DO"
raw "MUST METHOD sleep WITH hours"
raw "END CONTRACT"
raw "ABSTRACT BLUEPRINT Creature IMPLEMENTS Movable AND Eater AND Sleeper DO"
raw "PRIVATE energy"
raw "HAS name SET TO \"Unknown\""
raw "ALWAYS HAS totalCount SET TO 0"
raw "WHEN BORN WITH name DO"
self.name = name
self.energy = 100
Creature.totalCount = Creature.totalCount + 1
raw "ALWAYS METHOD count DO"
print("Total creatures: " + self.totalCount)
raw "SECRET METHOD rest WITH minutes DO"
self.energy = self.energy + minutes
raw "METHOD move WITH distance DO"
self.energy = self.energy - distance
print(self.name + " moves " + distance)
return self.energy
raw "METHOD eat WITH food DO"
print(self.name + " eats " + food)
SELF.rest(10)
raw "METHOD sleep WITH hours DO"
print(self.name + " sleeps for " + hours + " hours")
SELF.rest(hours) * BY 10
struct Lion : Creature {
  raw "ALWAYS HAS species SET TO \"Lion\""
  fn roar() {
    print(self.name + " roars loudly!")
  }
  fn eat(food) {
    super.eat(food)
    print(self.name + " tears into the meat fiercely.")
  }
}
struct Elephant : Creature {
  raw "ALWAYS HAS species SET TO \"Elephant\""
  fn trumpet() {
    print(self.name + " trumpets proudly!")
  }
  fn eat(food) {
    print(self.name + " gently munches on " + food)
  }
}
fn feedAll(animals AND food) {
  for a in animals {
    a.eat(food)
  }
}
fn march(animals AND distance) {
  for a in animals {
    a.move(distance)
  }
}
fn bedTime(animals AND hours) {
  for a in animals {
    a.sleep(hours)
  }
}
raw "TRY DO"
raw "SET simba TO NEW Lion WITH \"Simba\""
raw "SET dumbo TO NEW Elephant WITH \"Dumbo\""
let zoo = LIST OF simba + dumbo END LIST
simba.roar()
dumbo.trumpet()
Creature.count()
raw "DO march WITH zoo AND 3"
raw "DO feedAll WITH zoo AND \"bananas\""
raw "DO bedTime WITH zoo AND 8"
let energyLeft = DO move OF simba WITH 2
print("Simba's energy left: " + energyLeft)
print("Second animal via indexing: " + (ITEM AT 1 OF zoo).name)
raw "CATCH AS e DO"
print("Error: " + e)
raw "FINALLY DO"
print("=== End of OOP Feature Showcase ===")
raw "END TRY"

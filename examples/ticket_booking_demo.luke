raw "THIS IS CLASS SeatUnavailableException"
raw "HAS message SET TO \"No seats available\""
raw "WHEN BORN WITH errorMessage"
let message OF SELF = errorMessage
raw "END CONSTRUCTOR"
raw "THIS IS CLASS Ticket"
raw "HAS price"
raw "HAS availableSeats"
raw "WHEN BORN WITH ticketPrice AND totalSeats"
var price OF SELF = ticketPrice
var availableSeats OF SELF = totalSeats
raw "END CONSTRUCTOR"
raw "METHOD bookTicket WITH numberOfSeats"
if availableSeats OF SELF < numberOfSeats THEN {
  raw "THROW NEW SeatUnavailableException WITH \"Not enough seats available\""
}
availableSeats OF SELF = availableSeats OF SELF - numberOfSeats
print("Booked " + numberOfSeats + " seats successfully!")
print("Remaining seats:" + availableSeats OF SELF)
raw "METHOD cancelTicket WITH numberOfSeats"
availableSeats OF SELF = ADD numberOfSeats TO availableSeats OF SELF
print("Cancelled " + numberOfSeats + " seats successfully!")
print("Remaining seats:" + availableSeats OF SELF)
raw "METHOD setTotalSeats WITH newTotal"
availableSeats OF SELF = newTotal
print("Total seats set to " + newTotal)
raw "METHOD showInfo"
print("Price: $" + price OF SELF)
print("Available seats: " + availableSeats OF SELF)
raw "THIS IS CLASS MovieTicket EXTENDS Ticket"
raw "HAS movieTitle"
raw "WHEN BORN WITH title AND ticketPrice AND totalSeats"
let movieTitle OF SELF = title
price OF SELF = ticketPrice
availableSeats OF SELF = totalSeats
raw "END CONSTRUCTOR"
raw "METHOD showInfo"
print("Movie: " + movieTitle OF SELF)
print("Price: $" + price OF SELF)
print("Available seats: " + availableSeats OF SELF)
raw "THIS IS CLASS ConcertTicket EXTENDS Ticket"
raw "HAS artistName"
raw "WHEN BORN WITH artist AND ticketPrice AND totalSeats"
let artistName OF SELF = artist
price OF SELF = ticketPrice
availableSeats OF SELF = totalSeats
raw "END CONSTRUCTOR"
raw "METHOD showInfo"
print("Artist: " + artistName OF SELF)
print("Price: $" + price OF SELF)
print("Available seats: " + availableSeats OF SELF)
print("=== Interactive Ticket Booking System ===")
print("")
let artistName = USER FOR "Enter artist name: "()
print("")
raw "LET concertTicket BE NEW ConcertTicket WITH artistName AND 50 AND 100"
var running = true
while running == true {
  print("=== Concert Ticket Management ===")
  concertTicket.showInfo()
  print("")
  print("Menu Options:")
  print("1. Set total seats")
  print("2. Buy tickets")
  print("3. Cancel tickets")
  print("4. Exit")
  print("")
  let choice = USER FOR "Enter your choice (1-4): "()
  print("")
  if choice IS EQUAL TO "1" THEN {
    let newTotal = USER FOR "Enter new total seats: "()
    concertTicket.setTotalSeats(newTotal)
  } else {
    var numSeats = USER FOR "Enter number of seats to book: "()
    raw "TRY"
    concertTicket.bookTicket(numSeats)
    raw "CATCH error"
    print("Error: " + message OF error)
    raw "END TRY"
    raw "ELSE IF choice IS EQUAL TO \"3\" THEN"
    numSeats = USER FOR "Enter number of seats to cancel: "()
    concertTicket.cancelTicket(numSeats)
    raw "ELSE IF choice IS EQUAL TO \"4\" THEN"
    running = false
    print("Thank you for using the ticket booking system!")
    raw "ELSE"
    print("Invalid choice. Please enter 1-4.")
  }
  print("")
}

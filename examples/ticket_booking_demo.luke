// Interactive Ticket Booking System Demo

// Custom exception for seat unavailability
THIS IS CLASS SeatUnavailableException
  HAS message SET TO "No seats available"
  
  WHEN BORN WITH errorMessage
    SET message OF SELF TO errorMessage
  END CONSTRUCTOR
END CLASS

// Base ticket class
THIS IS CLASS Ticket
  HAS price
  HAS availableSeats
  
  WHEN BORN WITH ticketPrice AND totalSeats
    SET price OF SELF TO ticketPrice
    SET availableSeats OF SELF TO totalSeats
  END CONSTRUCTOR
  
  METHOD bookTicket WITH numberOfSeats
    IF availableSeats OF SELF IS LESS THAN numberOfSeats THEN
      THROW NEW SeatUnavailableException WITH "Not enough seats available"
    END IF
    SET availableSeats OF SELF TO SUBTRACT numberOfSeats FROM availableSeats OF SELF
    SPEAK "Booked " AND numberOfSeats AND " seats successfully!"
    SPEAK "Remaining seats:" AND availableSeats OF SELF
  END METHOD
  
  METHOD cancelTicket WITH numberOfSeats
    SET availableSeats OF SELF TO ADD numberOfSeats TO availableSeats OF SELF
    SPEAK "Cancelled " AND numberOfSeats AND " seats successfully!"
    SPEAK "Remaining seats:" AND availableSeats OF SELF
  END METHOD
  
  METHOD setTotalSeats WITH newTotal
    SET availableSeats OF SELF TO newTotal
    SPEAK "Total seats set to " AND newTotal
  END METHOD
  
  METHOD showInfo
    SPEAK "Price: $" AND price OF SELF
    SPEAK "Available seats: " AND availableSeats OF SELF
  END METHOD
END CLASS

// Movie ticket class
THIS IS CLASS MovieTicket EXTENDS Ticket
  HAS movieTitle
  
  WHEN BORN WITH title AND ticketPrice AND totalSeats
    SET movieTitle OF SELF TO title
    SET price OF SELF TO ticketPrice
    SET availableSeats OF SELF TO totalSeats
  END CONSTRUCTOR
  
  METHOD showInfo
    SPEAK "Movie: " AND movieTitle OF SELF
    SPEAK "Price: $" AND price OF SELF
    SPEAK "Available seats: " AND availableSeats OF SELF
  END METHOD
END CLASS

// Concert ticket class  
THIS IS CLASS ConcertTicket EXTENDS Ticket
  HAS artistName
  
  WHEN BORN WITH artist AND ticketPrice AND totalSeats
    SET artistName OF SELF TO artist
    SET price OF SELF TO ticketPrice
    SET availableSeats OF SELF TO totalSeats
  END CONSTRUCTOR
  
  METHOD showInfo
    SPEAK "Artist: " AND artistName OF SELF
    SPEAK "Price: $" AND price OF SELF
    SPEAK "Available seats: " AND availableSeats OF SELF
  END METHOD
END CLASS

// Interactive Menu System
SPEAK "=== Interactive Ticket Booking System ==="
SPEAK ""

// Get artist name from user
SET artistName TO ASK USER FOR "Enter artist name: "
SPEAK ""

// Create concert ticket with default values
LET concertTicket BE NEW ConcertTicket WITH artistName AND 50 AND 100

// Main menu loop
SET running TO true
WHILE running IS EQUAL TO true DO
  SPEAK "=== Concert Ticket Management ==="
  ASK concertTicket TO showInfo
  SPEAK ""
  SPEAK "Menu Options:"
  SPEAK "1. Set total seats"
  SPEAK "2. Buy tickets"
  SPEAK "3. Cancel tickets"
  SPEAK "4. Exit"
  SPEAK ""
  
  SET choice TO ASK USER FOR "Enter your choice (1-4): "
  SPEAK ""
  
  IF choice IS EQUAL TO "1" THEN
    SET newTotal TO ASK USER FOR "Enter new total seats: "
    ASK concertTicket TO setTotalSeats WITH newTotal
  ELSE IF choice IS EQUAL TO "2" THEN
    SET numSeats TO ASK USER FOR "Enter number of seats to book: "
    TRY
      ASK concertTicket TO bookTicket WITH numSeats
    CATCH error
      SPEAK "Error: " AND message OF error
    END TRY
  ELSE IF choice IS EQUAL TO "3" THEN
    SET numSeats TO ASK USER FOR "Enter number of seats to cancel: "
    ASK concertTicket TO cancelTicket WITH numSeats
  ELSE IF choice IS EQUAL TO "4" THEN
    SET running TO false
    SPEAK "Thank you for using the ticket booking system!"
  ELSE
    SPEAK "Invalid choice. Please enter 1-4."
  END IF
  
  SPEAK ""
END WHILE
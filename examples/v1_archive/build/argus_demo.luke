// Argus v0 — PLACE + PAINT (no FILL html strings)
// Build: luke BUILD examples/build/argus_demo.luke -target browser -o build/argus_demo

IMPORT std/js
IMPORT std/argus

NAME THE PAGE "Argus"

BRING FONT "Syne" FROM "https://fonts.googleapis.com/css2?family=Syne:wght@700&display=swap"

WEAR STYLE """
html, body { margin: 0; background: #0e1512; }
#brand, #lead { color: #f4fff8; font-family: Syne, sans-serif; }
#brand { font-size: 64px; font-weight: 700; letter-spacing: -0.03em; line-height: 1; }
#lead { font-size: 20px; font-weight: 500; opacity: 0.9; }
#cta {
  background: #f4a259; color: #101820; font-family: Syne, sans-serif;
  font-weight: 700; font-size: 16px; border-radius: 0;
}
#out { color: #d7f5e6; font-family: Syne, sans-serif; font-size: 16px; }
#hero { filter: brightness(0.75); }
"""

PLACE "hero" AS IMAGE AT 0, 0 SIZE 1280, 720 FROM "https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=2400&q=80"
PLACE "brand" AS TEXT AT 48, 420 SIZE 900, 80 SAY "LukeLang"
PLACE "lead" AS TEXT AT 48, 510 SIZE 640, 80 SAY "Argus — rendering engine. DOM presentment, Luke frames."
PLACE "cta" AS BUTTON AT 48, 610 SIZE 220, 48 SAY "Paint click"
PLACE "out" AS TEXT AT 48, 670 SIZE 640, 40 SAY ""
PAINT THE SCREEN

WHEN "cta" IS CLICKED DO
  PLACE "out" AS TEXT AT 48, 670 SIZE 640, 40 SAY "Painted by Argus — still LukeLang."
  PAINT THE SCREEN
END WHEN

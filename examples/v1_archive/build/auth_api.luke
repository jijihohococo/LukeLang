// Auth API beachhead — register/login/session/CSRF + Live Graph FOR CURRENT USER.
// Build: luke BUILD examples/build/auth_api.luke -o build/auth_api
// Port :8802 — httpServe budget 6.

IMPORT std/server
IMPORT std/sqlite
IMPORT std/json
IMPORT std/auth

MY NAME IS setup SET TO ASK dbOpen WITH "/tmp/luke_auth_api.db"
ASK dbExec WITH setup, "DROP TABLE IF EXISTS luke_auth_attempts"
ASK dbExec WITH setup, "DROP TABLE IF EXISTS luke_sessions"
ASK dbExec WITH setup, "DROP TABLE IF EXISTS luke_users"
ASK dbExec WITH setup, "DROP TABLE IF EXISTS notes"
ASK authInit WITH setup
ASK dbExec WITH setup, "CREATE TABLE notes(id INTEGER PRIMARY KEY, user_id TEXT NOT NULL, body TEXT NOT NULL)"
ASK dbClose WITH setup

THIS IS FUNCTION handle WITH req AS REQUEST DO
  MY NAME IS db SET TO ASK dbOpen WITH "/tmp/luke_auth_api.db"
  ASK authInit WITH db
  MY NAME IS method SET TO ASK httpMethod WITH req
  MY NAME IS path SET TO ASK httpPath WITH req
  MY NAME IS params AS MAP
  MY NAME IS answered AS FLAG SET TO FALSE

  IF method EQUALS "POST" DO
    IF ASK httpMatch WITH path, "/register", params DO
      MY NAME IS body SET TO ASK httpJson WITH req
      MY NAME IS emailNode SET TO ASK jsonGet WITH body, "email"
      MY NAME IS passwordNode SET TO ASK jsonGet WITH body, "password"
      MY NAME IS email SET TO ASK jsonAsText WITH emailNode
      MY NAME IS password SET TO ASK jsonAsText WITH passwordNode
      MY NAME IS uid SET TO ASK authCreateAccount WITH db, email, password
      IF uid EQUALS "" DO
        ASK httpReply WITH req, 400, "text/plain", "register failed"
        SET answered TO TRUE
      END IF
      IF NOT answered DO
        ASK httpReply WITH req, 200, "text/plain", "uid=" AND uid
        SET answered TO TRUE
        SPEAK "served=register"
      END IF
    END IF
  END IF

  IF NOT answered DO
    IF method EQUALS "POST" DO
      IF ASK httpMatch WITH path, "/login", params DO
        MY NAME IS body2 SET TO ASK httpJson WITH req
        MY NAME IS emailNode2 SET TO ASK jsonGet WITH body2, "email"
        MY NAME IS passwordNode2 SET TO ASK jsonGet WITH body2, "password"
        MY NAME IS email2 SET TO ASK jsonAsText WITH emailNode2
        MY NAME IS password2 SET TO ASK jsonAsText WITH passwordNode2
        MY NAME IS uid2 SET TO ASK authLogin WITH db, req, email2, password2
        IF uid2 EQUALS "" DO
          ASK httpReply WITH req, 401, "text/plain", "login failed"
          SET answered TO TRUE
        END IF
        IF NOT answered DO
          MY NAME IS csrf SET TO ASK authCsrf WITH req
          ASK httpReply WITH req, 200, "text/plain", "uid=" AND uid2 AND "|csrf=" AND csrf
          SET answered TO TRUE
          SPEAK "served=login"
        END IF
      END IF
    END IF
  END IF

  IF NOT answered DO
    IF method EQUALS "GET" DO
      IF ASK httpMatch WITH path, "/me", params DO
        REQUIRE LOGIN ON req WITH db
        ASK httpReply WITH req, 200, "text/plain", "me=" AND THE CURRENT USER
        SET answered TO TRUE
        SPEAK "served=me"
      END IF
    END IF
  END IF

  IF NOT answered DO
    IF method EQUALS "POST" DO
      IF ASK httpMatch WITH path, "/notes", params DO
        REQUIRE LOGIN ON req WITH db
        IF NOT ASK authCheckCsrf WITH db, req DO
          ASK httpReply WITH req, 403, "text/plain", "csrf"
          SET answered TO TRUE
        END IF
        IF NOT answered DO
          MY NAME IS body3 SET TO ASK httpJson WITH req
          MY NAME IS noteNode SET TO ASK jsonGet WITH body3, "body"
          MY NAME IS note SET TO ASK jsonAsText WITH noteNode
          MY NAME IS binds AS LIST
          ADD THE CURRENT USER TO binds
          ADD note TO binds
          ASK dbExecBind WITH db, "INSERT INTO notes(user_id, body) VALUES(?, ?)", binds
          ASK httpReply WITH req, 200, "text/plain", "note_ok"
          SET answered TO TRUE
          SPEAK "served=note"
        END IF
      END IF
    END IF
  END IF

  IF NOT answered DO
    IF method EQUALS "GET" DO
      IF ASK httpMatch WITH path, "/notes", params DO
        REQUIRE LOGIN ON req WITH db
        MY NAME IS nb AS LIST
        ADD THE CURRENT USER TO nb
        MY NAME IS bodies SET TO ASK dbQueryBind WITH db, "SELECT body FROM notes WHERE user_id = ?", nb
        ASK httpReply WITH req, 200, "text/plain", "notes=" AND bodies
        SET answered TO TRUE
        SPEAK "served=notes"
      END IF
    END IF
  END IF

  IF NOT answered DO
    IF method EQUALS "POST" DO
      IF ASK httpMatch WITH path, "/logout", params DO
        ASK authLogout WITH db, req
        ASK httpReply WITH req, 200, "text/plain", "bye"
        SET answered TO TRUE
        SPEAK "served=logout"
      END IF
    END IF
  END IF

  IF NOT answered DO
    ASK httpReply WITH req, 404, "text/plain", "not found"
  END IF

  ASK dbClose WITH db
END FUNCTION

SPEAK "auth_api :8802"
MY NAME IS server SET TO ASK httpListen WITH 8802
ASK httpServe WITH server, handle, 6
SPEAK "auth_api_done=1"

// LIMIT + login.remaining reactive cell + REVEAL + WHO SAW SINCE + SCRUB TO access.
// Build: luke BUILD examples/build/auth_lang_ok.luke -o build/auth_lang_ok

IMPORT std/sqlite
IMPORT std/auth

SPEAK "auth_lang_ok start"

LIMIT login TO 5 PER MINUTE PER ip

MY NAME IS db SET TO ASK dbOpen WITH "/tmp/luke_auth_lang_ok.db"
ASK dbExec WITH db, "DROP TABLE IF EXISTS luke_auth_attempts"
ASK dbExec WITH db, "DROP TABLE IF EXISTS luke_sessions"
ASK dbExec WITH db, "DROP TABLE IF EXISTS luke_users"
ASK dbExec WITH db, "DROP TABLE IF EXISTS profiles"
ASK authInit WITH db
ASK dbExec WITH db, "CREATE TABLE profiles(user_id TEXT PRIMARY KEY, ssn TEXT NOT NULL)"

MY NAME IS uid SET TO ASK authCreateAccount WITH db, "lang@example.com", "password long enough"
MY NAME IS ba AS LIST
ADD uid TO ba
ADD "078-05-1120" TO ba
ASK dbExecBind WITH db, "INSERT INTO profiles(user_id, ssn) VALUES(?, ?)", ba

MAKE SURE ASK authAssume WITH uid EQUALS TRUE

SECRET REMEMBER ssn AS TEXT SET TO "078-05-1120"
REVEAL last 4 OF ssn AS masked
SPEAK "masked=" AND masked
BIND "lab" TO masked

WHO SAW ssn SINCE "last week"
SCRUB TO access OF ssn

REFRESH LIMIT login WITH db, "lang@example.com"
SPEAK "remaining=" AND login.remaining
BIND "attempts_left" TO login.remaining

SPEAK "chain_ok=" AND ASK authSawVerify

ASK dbClose WITH db
SPEAK "auth_lang_ok=1"

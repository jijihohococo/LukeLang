// Auth-as-types spike — SECRET + WATCH … FOR CURRENT USER + BIND is allowed.
// Build: luke BUILD examples/build/auth_secret_ok.luke -o build/auth_secret_ok

IMPORT std/sqlite
IMPORT std/auth

SPEAK "auth_secret_ok start"

MY NAME IS db SET TO ASK dbOpen WITH "/tmp/luke_auth_secret_ok.db"
ASK dbExec WITH db, "DROP TABLE IF EXISTS profiles"
ASK dbExec WITH db, "DROP TABLE IF EXISTS luke_auth_attempts"
ASK dbExec WITH db, "DROP TABLE IF EXISTS luke_sessions"
ASK dbExec WITH db, "DROP TABLE IF EXISTS luke_users"
ASK dbExec WITH db, "CREATE TABLE profiles(user_id TEXT PRIMARY KEY, ssn TEXT NOT NULL)"
ASK authInit WITH db

MY NAME IS uid SET TO ASK authCreateAccount WITH db, "secret@example.com", "password long enough"
MY NAME IS ba AS LIST
ADD uid TO ba
ADD "078-05-1120" TO ba
ASK dbExecBind WITH db, "INSERT INTO profiles(user_id, ssn) VALUES(?, ?)", ba

SECRET REMEMBER ssn AS TEXT
MAKE SURE ASK authAssume WITH uid EQUALS TRUE
WATCH ssn FROM db AS "SELECT ssn FROM profiles WHERE user_id = ?" FOR CURRENT USER

BIND "lab" TO ssn
SPEAK "ssn_cell=" AND ssn
WHO SAW ssn
SPEAK "trail=" AND ASK authWhoSaw WITH "ssn"

MY NAME IS left SET TO ASK authAttemptsLeft WITH db, "secret@example.com"
SPEAK "attempts_left=" AND left

REVOKE ACCESS
SPEAK "after_revoke_user=" AND THE CURRENT USER
SPEAK "after_revoke_ssn=" AND ssn

ASK dbClose WITH db
SPEAK "auth_secret_ok=1"

// WRAP + checkbox/radio + viewport + breakpoints + motion beachhead
// Build: luke BUILD examples/build/frontend_wrap_forms.luke -o build/ex_frontend_wrap_forms

IMPORT std/hanka
IMPORT std/argus

SPEAK "vw=" AND THE VIEWPORT WIDTH
SPEAK "vh=" AND THE VIEWPORT HEIGHT

BEGIN ROW AT 0, 0 SIZE 220, 120 PAD 4 GAP 8 WRAP
  SLOT BUTTON "b1" SIZE 90, 36 SAY "One"
  SLOT BUTTON "b2" SIZE 90, 36 SAY "Two"
  SLOT BUTTON "b3" SIZE 90, 36 SAY "Three"
END ROW

BEGIN COLUMN AT 0, 140 SIZE 320, 200 PAD 8 GAP 12
  SLOT INPUT AS CHECKBOX "agree" SIZE 24, 24 SAY "I agree"
  SLOT INPUT AS RADIO "plan_free" SIZE 24, 24 SAY "Free"
  SLOT INPUT AS RADIO "plan_pro" SIZE 24, 24 SAY "Pro"
  SLOT INPUT AS EMAIL "email" SIZE 280, 36 SAY "you@luke.dev"
END COLUMN

LAY OUT THE SCREEN
PAINT THE SCREEN

SET THE OPACITY OF "b1" TO 0.25
FADE "b1" FROM 0.25 TO 1 OVER 48

WHEN THE VIEWPORT CHANGES DO
  SPEAK "resized=" AND THE VIEWPORT WIDTH
END WHEN

WHEN THE VIEWPORT IS AT LEAST 800 WIDE DO
  SPEAK "bp_wide=1"
END WHEN

WHEN THE VIEWPORT IS UNDER 480 DO
  SPEAK "bp_narrow=1"
END WHEN

WHEN THE VIEWPORT IS BETWEEN 480 AND 799 WIDE DO
  SPEAK "bp_mid=1"
END WHEN

SPEAK "wrap=1"
SPEAK "ok=1"

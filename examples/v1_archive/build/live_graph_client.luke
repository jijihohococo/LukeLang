// Live Graph tier 2 — client half (browser)
// WATCH + BIND only. No FETCH, no SUBSCRIBE, no TIMELINE, no poll in this program.
// Server WATCH FROM db → PUSH WATCH → SSE → cell → one region paint.
// Build: luke BUILD examples/build/live_graph_client.luke -target browser -o build/live_graph_client
// Needs: live_graph_server on :8798

IMPORT std/js
IMPORT std/hanka
IMPORT std/argus

NAME THE PAGE "Luke Live Graph"

WEAR STYLE """
html, body { margin: 0; background: #0e1512; color: #f4fff8; font-family: Georgia, serif; }
#brand { font-size: 40px; font-weight: 700; }
#name { font-size: 28px; }
#hint { font-size: 14px; opacity: 0.7; }
"""

REMEMBER user AS ""
REMEMBER display AS ""
REMEMBER history AS LIST
REMEMBER region_now AS 0
REMEMBER events AS 0
REMEMBER replayed AS NUMBER SET TO 0

BEGIN COLUMN AT 40, 40 SIZE 720, 200 PAD 0 GAP 14
  SLOT TEXT "brand" SIZE AUTO, 48 SAY "LukeLang"
  SLOT TEXT "name" SIZE AUTO, 40 SAY "name: —"
  SLOT TEXT "hint" SIZE AUTO, 32 SAY "Live Graph — DB row to pixel, zero glue."
END COLUMN

LAY OUT THE SCREEN
PAINT THE SCREEN

BIND "name" TO display

WATCH user FROM "http://127.0.0.1:8798/watch"

WHEN REACTIVE user CHANGES DO
  ADD user TO history
  IF replayed EQUALS 0 DO
    // Normal mode: keep display following the live user cell.
    CHANGE display TO user
    IF user EQUALS "Ada3" DO
      // When Ada3 arrives, scrub backward to history[0] ("seed").
      BEGIN REACTIVE BATCH
        CHANGE replayed TO 1
        CHANGE display TO ITEM 0 OF history
      END REACTIVE BATCH
      SPEAK "replay=rewind0"
    END IF
  END IF
END WHEN REACTIVE

// Region paint is counted on the BIND flush for `display` (may be deferred
// when nested under the user-cell flush from SSE).
WHEN REACTIVE display CHANGES DO
  CHANGE region_now TO THE REGION PAINT COUNT
  SPEAK "region=" AND region_now
END WHEN REACTIVE

WHEN WATCH user IS READY DO
  CHANGE events TO events ADD 1
  SPEAK "user=" AND user
  SPEAK "display=" AND display
  SPEAK "events=" AND events
  UPDATE "hint" WITH "live — region paints: " AND region_now
END WHEN

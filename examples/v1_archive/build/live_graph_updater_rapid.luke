// Live Graph tier 3 — external rapid writer
// Drives multiple UPDATEs to test that the Live Graph still repaints one node
// per distinct value (region=1 stays minimal) under successive commits.
//
// Build: luke BUILD examples/build/live_graph_updater_rapid.luke -o build/live_graph_updater_rapid

IMPORT std/sqlite
IMPORT std/argus

MY NAME IS db SET TO ASK dbOpen WITH "/tmp/luke_live_graph.db"
ASK dbExec WITH db, "PRAGMA journal_mode=WAL"

ASK dbExec WITH db, "UPDATE users SET name='Ada1' WHERE id = 1"
MY NAME IS t0 AS NUMBER SET TO THE CLOCK
WHILE THE CLOCK SUBTRACT t0 IS LESS THAN 120 DO
END WHILE

ASK dbExec WITH db, "UPDATE users SET name='Ada2' WHERE id = 1"
SET t0 TO THE CLOCK
WHILE THE CLOCK SUBTRACT t0 IS LESS THAN 120 DO
END WHILE

ASK dbExec WITH db, "UPDATE users SET name='Ada3' WHERE id = 1"

ASK dbClose WITH db
SPEAK "updated=Ada3"


// LukeLang — SQLite (native Build). Links -lsqlite3 automatically.

IMPORT std/sqlite

MY NAME IS db SET TO ASK dbOpen WITH "/tmp/luke_demo.db"
ASK dbExec WITH db, "CREATE TABLE IF NOT EXISTS notes(id INTEGER PRIMARY KEY, body TEXT)"
ASK dbExec WITH db, "DELETE FROM notes"
ASK dbExec WITH db, "INSERT INTO notes(body) VALUES('hello from LukeLang')"
ASK dbExec WITH db, "INSERT INTO notes(body) VALUES('arena memory, no GC')"

MY NAME IS rows SET TO ASK dbQuery WITH db, "SELECT body FROM notes ORDER BY id"
SPEAK rows
ASK dbClose WITH db

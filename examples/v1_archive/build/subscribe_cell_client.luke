// Spike A part 2 — SSE push client (browser). Zero poll/fetch/timer glue.
// START SUBSCRIBE → cell → BIND → region=1 per server event.
// Build: luke BUILD examples/build/subscribe_cell_client.luke -target browser -o build/subscribe_cell_client
// Needs: subscribe_cell_server on :8793

IMPORT std/js
IMPORT std/hanka
IMPORT std/argus

NAME THE PAGE "Luke Subscribe Cell"

WEAR STYLE """
html, body { margin: 0; background: #0e1512; color: #f4fff8; font-family: Georgia, serif; }
#brand { font-size: 40px; font-weight: 700; }
#counter { font-size: 28px; }
#hint { font-size: 14px; opacity: 0.7; }
"""

REMEMBER server_count AS ""
REMEMBER ready AS 0
REMEMBER region_now AS 0
REMEMBER events AS 0

BEGIN COLUMN AT 40, 40 SIZE 720, 200 PAD 0 GAP 14
  SLOT TEXT "brand" SIZE AUTO, 48 SAY "LukeLang"
  SLOT TEXT "counter" SIZE AUTO, 40 SAY "cell: —"
  SLOT TEXT "hint" SIZE AUTO, 32 SAY "SUBSCRIBE — server push, one region paint."
END COLUMN

LAY OUT THE SCREEN
PAINT THE SCREEN

BIND "counter" TO "cell: " AND server_count

START SUBSCRIBE "feed" GET "http://127.0.0.1:8793/events" INTO server_count READY ready

WHEN SUBSCRIBE "feed" IS READY DO
  CHANGE region_now TO THE REGION PAINT COUNT
  CHANGE events TO events ADD 1
  SPEAK "cell=" AND server_count
  SPEAK "region=" AND region_now
  SPEAK "events=" AND events
  UPDATE "hint" WITH "push ok — region paints: " AND region_now
END WHEN

// Spike A part 2 — SSE push server (native)
// GET /events streams incrementing counts. CI-friendly accept budget.
// Build: luke BUILD examples/build/subscribe_cell_server.luke -o build/subscribe_cell_server

IMPORT std/server
IMPORT std/argus

SPEAK "subscribe_cell server :8793 /events"

MY NAME IS server SET TO ASK httpListen WITH 8793
MY NAME IS left AS NUMBER SET TO 6

WHILE left IS GREATER THAN 0 DO
  MY NAME IS req SET TO ASK httpAccept WITH server
  MY NAME IS path SET TO ASK httpPath WITH req
  MY NAME IS hit AS FLAG SET TO FALSE
  IF path EQUALS "/events" DO
    SET hit TO TRUE
    ASK httpSseOpen WITH req
    MY NAME IS n AS NUMBER SET TO 0
    WHILE n IS LESS THAN 8 DO
      SET n TO n ADD 1
      ASK httpSseComment WITH req, "beat"
      ASK httpSseData WITH req, "" AND n
      SPEAK "push=" AND n
      MY NAME IS t0 AS NUMBER SET TO THE CLOCK
      WHILE THE CLOCK SUBTRACT t0 IS LESS THAN 40 DO
      END WHILE
    END WHILE
    ASK httpClose WITH req
  END IF
  IF NOT hit DO
    ASK httpReply WITH req, 404, "text/plain", "not found"
  END IF
  SET left TO left SUBTRACT 1
END WHILE

SPEAK "server done"

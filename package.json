{
  "name": "lukelang",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "description": "LukeLang — conversational language. Canonical toolchain is vm/; JS bin/scripts are deprecated (see docs/LEGACY.md).",
  "bin": {
    "luke": "./luke.js"
  },
  "scripts": {
    "build:native": "make -C vm",
    "test:native": "make -C vm test",
    "show:native": "make -C vm && vm/build/luke SHOW examples/build/hello.luke",
    "build:legacy-js": "node main.js",
    "show:legacy-js": "node main.js SHOW examples/oop_full.luke"
  }
}

{
  "Function": {
    "prefix": "luke-fn",
    "body": [
      "fn ${1:name}(${2:value}: ${3:float}) -> ${4:float} {",
      "  ${5:print(${2:value})}",
      "  return ${2:value}",
      "}"
    ],
    "description": "LukeLang function template (syntax v2)"
  },
  "If block": {
    "prefix": "luke-if",
    "body": [
      "if ${1:condition} {",
      "  ${2:print(\"ok\")}",
      "}"
    ],
    "description": "LukeLang if block"
  },
  "Reactive cell + derived": {
    "prefix": "luke-rx",
    "body": [
      "signal ${1:price} = ${2:100}",
      "signal ${3:quantity} = ${4:2}",
      "derived ${5:total} = ${1:price} * ${3:quantity}",
      "print(\"${5:total}=\" + ${5:total})"
    ],
    "description": "Reactive cell example"
  },
  "Route handler skeleton": {
    "prefix": "luke-route",
    "body": [
      "fn handle(req: Request) {",
      "  let method = httpMethod(req)",
      "  let path = httpPath(req)",
      "  var params: map = {}",
      "  if method == \"GET\" {",
      "    if httpMatch(path, \"/ok\", params) {",
      "      httpReply(req, 200, \"text/plain\", \"ok\")",
      "    }",
      "  }",
      "}"
    ],
    "description": "Backend route handler template"
  },
  "Test block": {
    "prefix": "luke-test",
    "body": [
      "test \"${1:name}\" {",
      "  assert ${2:left} == ${3:right}",
      "}"
    ],
    "description": "LukeLang test template"
  },
  "Struct": {
    "prefix": "luke-struct",
    "body": [
      "struct ${1:Name} {",
      "  ${2:field}: ${3:str}",
      "",
      "  init(${2:field}: ${3:str}) {",
      "    self.${2:field} = ${2:field}",
      "  }",
      "",
      "  fn ${4:method}() {",
      "    ${5:print(self.${2:field})}",
      "  }",
      "}"
    ],
    "description": "LukeLang struct template"
  }
}

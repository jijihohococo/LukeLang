{
  "scopeName": "source.luke",
  "name": "LukeLang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords-v2" },
    { "include": "#types-v2" },
    { "include": "#constants-v2" },
    { "include": "#keywords-v1" },
    { "include": "#types-v1" },
    { "include": "#constants-v1" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.luke",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.luke",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.luke",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.double.luke",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.luke",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.luke",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "types-v2": {
      "patterns": [
        {
          "name": "storage.type.luke",
          "match": "\\b(?:int|float|str|bool|json|list|map|Server|Request|Db)\\b"
        }
      ]
    },
    "constants-v2": {
      "patterns": [
        {
          "name": "constant.language.luke",
          "match": "\\b(?:true|false|null|self|super|current_user|clock)\\b"
        }
      ]
    },
    "keywords-v2": {
      "patterns": [
        {
          "name": "keyword.control.luke",
          "match": "\\b(?:if|else|while|for|in|fn|return|break|continue|try|catch|throw|arena|test|assert|import|struct|init|private|raw)\\b"
        },
        {
          "name": "keyword.other.reactive.luke",
          "match": "\\b(?:let|var|signal|secret|derived|effect|batch|watch|bind|from|where|as|on)\\b"
        },
        {
          "name": "support.function.output.luke",
          "match": "\\b(?:print|fill|paint|layout|page)\\b"
        }
      ]
    },
    "types-v1": {
      "patterns": [
        {
          "name": "storage.type.luke",
          "match": "\\b(?:NUMBER|INTEGER|TEXT|FLAG|JSON|LIST|MAP|REQUEST|SERVER|DATABASE)\\b"
        }
      ]
    },
    "constants-v1": {
      "patterns": [
        {
          "name": "constant.language.luke",
          "match": "\\b(?:TRUE|FALSE|NULL)\\b"
        }
      ]
    },
    "keywords-v1": {
      "patterns": [
        {
          "name": "keyword.control.luke",
          "match": "\\b(?:IF|ELSE|END IF|END WHEN|END WHEN REACTIVE|WHEN|DO|THIS IS FUNCTION|END FUNCTION|GIVE BACK|SEND BACK|HAND BACK|ATTEMPT|OTHERWISE|END ATTEMPT|BEGIN REACTIVE BATCH|END REACTIVE BATCH|BEGIN|END|BLUEPRINT|CLASS|END BLUEPRINT|END CLASS|METHOD|WHEN BORN|END BORN)\\b"
        },
        {
          "name": "keyword.operator.word.luke",
          "match": "\\b(?:SET TO|SET|CHANGE|INCREASE|DECREASE|ADD|PUT|GET|FROM|TO|AND|OR|NOT|EQUALS|MULTIPLIED BY|DIVIDED BY|MOD|ASK|WITH|IS|AS|IMPORT|WATCH|PUSH WATCH|BIND|SECRET REMEMBER|REMEMBER|MY NAME IS|HAS|NEW|IN ARENA|END ARENA)\\b"
        },
        {
          "name": "support.function.output.luke",
          "match": "\\b(?:SPEAK|SAY|YELL)\\b"
        }
      ]
    }
  }
}

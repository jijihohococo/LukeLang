fn authInit(db: Db) -> bool {
  return __luke_auth_init(db)
}
fn authCreateAccount(db: Db, email: str, password: str) -> str {
  return __luke_auth_create_account(db, email, password)
}
fn authLogin(db: Db, req: Request, email: str, password: str) -> str {
  return __luke_auth_login(db, req, email, password)
}
fn authLogout(db: Db, req: Request) -> bool {
  return __luke_auth_logout(db, req)
}
fn authRequire(db: Db, req: Request) -> bool {
  return __luke_auth_require(db, req)
}
fn authCsrf(req: Request) -> str {
  return __luke_auth_csrf(req)
}
fn authCheckCsrf(db: Db, req: Request) -> bool {
  return __luke_auth_check_csrf(db, req)
}
fn authAssume(uid: str) -> bool {
  return __luke_auth_assume(uid)
}
fn authWhoSaw(field: str) -> str {
  return __luke_auth_who_saw(field)
}
fn authAttemptsLeft(db: Db, email: str) -> str {
  return __luke_auth_attempts_left(db, email)
}
fn authSawVerify() -> float {
  return __luke_auth_saw_verify()
}

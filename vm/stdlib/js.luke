fn jsSetText(id: str, text: str) -> bool {
  return __luke_js_set_text(id, text)
}
fn jsSetHtml(id: str, html: str) -> bool {
  return __luke_js_set_html(id, html)
}
fn jsGetValue(id: str) -> str {
  return __luke_js_get_value(id)
}
fn jsFetch(url: str) -> str {
  return __luke_js_fetch(url)
}
fn jsOnClick(id: str, target: str, message: str) -> bool {
  return __luke_js_on_click(id, target, message)
}
fn jsAddStyle(css: str) -> bool {
  return __luke_js_add_style(css)
}
fn jsLoadFont(href: str) -> bool {
  return __luke_js_load_font(href)
}
fn jsSetTitle(title: str) -> bool {
  return __luke_js_set_title(title)
}

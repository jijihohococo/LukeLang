// IMPORT std/js — browser DOM bridge (no-ops on native)

THIS IS FUNCTION jsSetText WITH id AS TEXT, text AS TEXT GIVES BACK FLAG DO
  GIVE BACK __luke_js_set_text(id, text)
END FUNCTION

THIS IS FUNCTION jsSetHtml WITH id AS TEXT, html AS TEXT GIVES BACK FLAG DO
  GIVE BACK __luke_js_set_html(id, html)
END FUNCTION

THIS IS FUNCTION jsGetValue WITH id AS TEXT GIVES BACK TEXT DO
  GIVE BACK __luke_js_get_value(id)
END FUNCTION

THIS IS FUNCTION jsFetch WITH url AS TEXT GIVES BACK TEXT DO
  GIVE BACK __luke_js_fetch(url)
END FUNCTION

THIS IS FUNCTION jsOnClick WITH id AS TEXT, target AS TEXT, message AS TEXT GIVES BACK FLAG DO
  GIVE BACK __luke_js_on_click(id, target, message)
END FUNCTION

THIS IS FUNCTION jsAddStyle WITH css AS TEXT GIVES BACK FLAG DO
  GIVE BACK __luke_js_add_style(css)
END FUNCTION

THIS IS FUNCTION jsLoadFont WITH href AS TEXT GIVES BACK FLAG DO
  GIVE BACK __luke_js_load_font(href)
END FUNCTION

THIS IS FUNCTION jsSetTitle WITH title AS TEXT GIVES BACK FLAG DO
  GIVE BACK __luke_js_set_title(title)
END FUNCTION

  return __luke_json_len(value)
}
fn jsonHas(obj: json, key: str) -> bool {
  return __luke_json_has(obj, key)
}
fn jsonAsText(value: json) -> str {
  return __luke_json_as_text(value)
}
fn jsonAsNumber(value: json) -> float {
  return __luke_json_as_number(value)
}
fn jsonAsInteger(value: json) -> int {
  return __luke_json_as_integer(value)
}

fn pgOpen(conninfo: str) -> PGCONN {
  return __luke_pg_open(conninfo)
}
fn pgExecBind(pg: PGCONN, sql: str, params: list) -> bool {
  return __luke_pg_exec_bind(pg, sql, params)
}
fn pgQueryBind(pg: PGCONN, sql: str, params: list) -> str {
  return __luke_pg_query_bind(pg, sql, params)
}
fn pgRowsBind(pg: PGCONN, sql: str, params: list) -> str {
  return __luke_pg_rows_bind(pg, sql, params)
}
fn pgClose(pg: PGCONN) -> bool {
  return __luke_pg_close(pg)
}
fn pgCheckout(pg: PGCONN) -> bool {
  return __luke_pg_checkout(pg)
}
fn pgCheckin(pg: PGCONN) -> bool {
  return __luke_pg_checkin(pg)
}

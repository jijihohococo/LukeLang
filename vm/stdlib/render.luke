import std/argus
fn renderPlaceText(id: str, x: float, y: float, w: float, h: float, text: str) -> bool {
  return argusPlaceText(id, x, y, w, h, text)
}
fn renderPlaceButton(id: str, x: float, y: float, w: float, h: float, text: str) -> bool {
  return argusPlaceButton(id, x, y, w, h, text)
}
fn renderPlaceImage(id: str, x: float, y: float, w: float, h: float, src: str) -> bool {
  return argusPlaceImage(id, x, y, w, h, src)
}
fn renderPaint() -> bool {
  return argusPaint()
}

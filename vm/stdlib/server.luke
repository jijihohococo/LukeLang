fn httpListen(port: float) -> Server {
  return __luke_http_listen(port)
}
fn httpAccept(server: Server) -> Request {
  return __luke_http_accept(server)
}
fn httpReply(req: Request, status: float, contentType: str, body: str) -> bool {
  return __luke_http_reply(req, status, contentType, body)
}
fn httpChunkOpen(req: Request, status: float, contentType: str) -> bool {
  return __luke_http_chunk_open(req, status, contentType)
}
fn httpChunk(req: Request, data: str) -> bool {
  return __luke_http_chunk(req, data)
}
fn httpChunkEnd(req: Request) -> bool {
  return __luke_http_chunk_end(req)
}
fn httpClientIp(req: Request) -> str {
  return __luke_http_client_ip(req)
}
fn httpSseOpen(req: Request) -> bool {
  return __luke_http_sse_open(req)
}
fn httpSseData(req: Request, data: str) -> bool {
  return __luke_http_sse_data(req, data)
}
fn httpSseId(req: Request, id: str) -> bool {
  return __luke_http_sse_id(req, id)
}
fn httpSseComment(req: Request, comment: str) -> bool {
  return __luke_http_sse_comment(req, comment)
}
fn httpClose(req: Request) -> bool {
  return __luke_http_close(req)
}
fn httpPath(req: Request) -> str {
  return __luke_http_path(req)
}
fn httpMethod(req: Request) -> str {
  return __luke_http_method(req)
}
fn httpQuery(req: Request) -> str {
  return __luke_http_query(req)
}
fn httpBody(req: Request) -> str {
  return __luke_http_body(req)
}
fn httpLastEventId(req: Request) -> str {
  return __luke_http_last_event_id(req)
}
fn httpMatch(path: str, pattern: str, params: map) -> bool {
  return __luke_http_match(path, pattern, params)
}
fn httpQueryMap(req: Request) -> map {
  return __luke_http_query_map(req)
}
fn httpFormMap(req: Request) -> map {
  return __luke_http_form_map(req)
}
fn httpHeader(req: Request, name: str) -> str {
  return __luke_http_header(req, name)
}
fn httpCookie(req: Request, name: str) -> str {
  return __luke_http_cookie(req, name)
}
fn httpSetCookie(req: Request, name: str, value: str) -> bool {

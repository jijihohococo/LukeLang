fn dbOpen(path: str) -> Db {
  return __luke_db_open(path)
}
fn dbExec(db: Db, sql: str) -> bool {
  return __luke_db_exec(db, sql)
}
fn dbExecBind(db: Db, sql: str, params: list) -> bool {
  return __luke_db_exec_bind(db, sql, params)
}
fn dbQuery(db: Db, sql: str) -> str {
  return __luke_db_query(db, sql)
}
fn dbQueryBind(db: Db, sql: str, params: list) -> str {
  return __luke_db_query_bind(db, sql, params)
}
fn dbClose(db: Db) -> bool {
  return __luke_db_close(db)
}

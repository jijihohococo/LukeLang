import std/js
fn goTo(path: str) -> bool {
  return __luke_js_route_go(path)
}
fn readField(id: str) -> str {
  return __luke_js_get_value(id)
}
fn startFetchGet(id: str, url: str) -> bool {
  return __luke_js_fetch_start(id, "GET", url, "")
}
fn startFetchPost(id: str, url: str, body: str) -> bool {
  return __luke_js_fetch_start(id, "POST", url, body)
}
fn fetchReady(id: str) -> bool {
  return __luke_js_fetch_ready(id)
}
fn fetchStatus(id: str) -> float {
  return __luke_js_fetch_status(id)
}
fn fetchBody(id: str) -> str {
  return __luke_js_fetch_body(id)
}
fn looksLikeEmail(s: str) -> bool {
  return __luke_looks_like_email(s)
}
fn textNonempty(s: str) -> bool {
  return __luke_text_nonempty(s)
}
